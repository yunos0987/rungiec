(* rungiec_ld.iec - the LD mode of RUNGIEC: the public macros write the IEC 61131-10 LD XML of Rung objects into the ld body instead of ST. *)
(* rungiec.iec includes this file at its end in the LD mode (RUNGIEC_LD defined and nonzero); include rungiec.iec, not this file. Convert with jiepp -P -nC (or jiecc -D RUNGIEC_LD -P -nC): a line marker or a comment left in the ld body breaks the XML. *)
{#pragma once}
{#if !(defined(_RUNGIEC_LD) && _RUNGIEC_LD = 1)}
{#error RUNGIEC rungiec_ld.iec is the LD mode part of rungiec.iec; include rungiec.iec instead}
{#else}
(* Settings of the LD mode. RUNGIEC_LD_FANIN_MAX is the largest number of IDs that merge into one input (the ends of the branches of a PARALLEL); the generated set operations end at 32. The depth and arity tables end at 16 and 32. *)
{#ifndef RUNGIEC_LD_FANIN_MAX}
{#define RUNGIEC_LD_FANIN_MAX 16}
{#endif}
{#if RUNGIEC_LD_FANIN_MAX < 1 || RUNGIEC_LD_FANIN_MAX > 32}
{#error RUNGIEC LD: merge limit RUNGIEC_LD_FANIN_MAX is out of range 1 to 32}
{#endif}
{#if RUNGIEC_NEST_MAX > 16}
{#error RUNGIEC LD: nest limit RUNGIEC_NEST_MAX exceeds 16, the depth of the generated LD tables}
{#endif}
(* JMP and LABEL write the LD objects Jump and the label of a Rung, so every target allows them (the checks of JMP and LABEL in rungiec.iec read this). *)
{#define _RUNGIEC_JUMP_OK 1}

(* Tags. In the LD mode an element, SERIES and PARALLEL only rewrite themselves to a tag followed by their arguments (CONTACT of A becomes _RUNGIEC_LD_CONTACT_T followed by A in parentheses). A tag is not a macro, so it stays unchanged however often it is passed on. The arity check and the edge slot (and its check) are done once, at this rewrite. *)
(* A statement macro (RUNG) evaluates its children from the top: _RUNGIEC_LD_EV<L> checks the tag (_RUNGIEC_LD_CHECK) and pastes _RUNGIEC_LD_EV<L>_ to it, which selects the element or combinator of depth L. jiepp does not expand a macro inside itself, so every macro on the evaluation path has one generated copy per depth. *)
(* _RUNGIEC_LD_CHECK evaluates the table entry of the child into a counter and compares the counter with 31415 (comparing the expression directly gives the type error PP50 for a trailing or B, not the check PP91). It pastes _RUNGIEC_LD_IS_ to the first token of the child. A tag gives the token _RUNGIEC_LD_TAG, which is not a macro. The token is then pasted to a prefix on its first token and to a suffix on its last token (_RUNGIEC_CAT3_X), and the result is a name defined as 31415 only when the child is the tag alone: a tag followed by more tokens (a trailing expression such as or B, or a missing comma) puts the suffix on another token, and anything else (a bare name, A and B, A = B) gives a name that is not defined. The value is not 1, so that a child such as A = B does not pass. The check is PP91 whether or not -Werror=undef is given. *)
{#define _RUNGIEC_LD_TAGOF__RUNGIEC_LD_TAG_ 31415}
{#define _RUNGIEC_LD_CHECK(node) _RUNGIEC_LD_SET(_rungiec_ld_t, 0)_RUNGIEC_LD_SET(_rungiec_ld_t, _RUNGIEC_CAT3_X(_RUNGIEC_LD_TAGOF_, _RUNGIEC_CAT_X(_RUNGIEC_LD_IS_, node), _))__assert(_RUNGIEC_LD_GET(_rungiec_ld_t) = 31415, RUNGIEC LD: a child is not an element, SERIES or PARALLEL)}
{#define _RUNGIEC_LD_EDGE(tag, x, n) _RUNGIEC_EDGE_CHECK(n)tag (x)}

(* Sets of IDs in named counters: set p has the size p_n and the members p_s0, p_s1 and so on. The counter names are pasted, so they reach the counter built-ins as parameters. _rungiec_ld_i<L> and _rungiec_ld_o<L> are the input and output sets of depth L; _rungiec_ld_n<K> is the set of network node K, _rungiec_ld_nr<K> is 1 once a WIRE has read node K, and _rungiec_ld_r is the right power rail set of a network; _rungiec_ld_t is a scratch counter. *)
{#define _RUNGIEC_LD_GET(c) __counter_peek(c)}
{#define _RUNGIEC_LD_SET(c, v) __counter_set(c, v)}
{#define _RUNGIEC_LD_N(p) _RUNGIEC_CAT_X(p, _n)}
{#define _RUNGIEC_LD_S(p, k) _RUNGIEC_CAT_X(_RUNGIEC_CAT_X(p, _s), k)}
{#define _RUNGIEC_LD_CLR(p) _RUNGIEC_LD_SET(_RUNGIEC_LD_N(p), 0)}
{#define _RUNGIEC_LD_ONE(p, v) _RUNGIEC_LD_SET(_RUNGIEC_LD_N(p), 1)_RUNGIEC_LD_SET(_RUNGIEC_LD_S(p, 0), v)}
{#define _RUNGIEC_LD_COPY(s, d) _RUNGIEC_LD_SET(_RUNGIEC_LD_N(d), _RUNGIEC_LD_GET(_RUNGIEC_LD_N(s)))_RUNGIEC_CAT_X(_RUNGIEC_LD_CP_, _RUNGIEC_LD_GET(_RUNGIEC_LD_N(s)))(s, d)}
{#define _RUNGIEC_LD_APPEND(s, d) _RUNGIEC_CAT_X(_RUNGIEC_LD_AP_, _RUNGIEC_LD_GET(_RUNGIEC_LD_N(s)))(s, d)}
(* _RUNGIEC_LD_PUSH adds v to p unless p has it already. *)
{#define _RUNGIEC_LD_PUSH(p, v) _RUNGIEC_LD_SET(_rungiec_ld_t, _RUNGIEC_CAT_X(_RUNGIEC_LD_HAS_, _RUNGIEC_LD_GET(_RUNGIEC_LD_N(p)))(p, v))_RUNGIEC_CAT_X(_RUNGIEC_LD_PUSH_, _RUNGIEC_LD_GET(_rungiec_ld_t))(p, v)}
{#define _RUNGIEC_LD_PUSH_0(p, v) __assert(_RUNGIEC_LD_GET(_RUNGIEC_LD_N(p)) < RUNGIEC_LD_FANIN_MAX, RUNGIEC LD: too many parallel ends merge into one element; raise RUNGIEC_LD_FANIN_MAX)_RUNGIEC_LD_SET(_RUNGIEC_LD_S(p, _RUNGIEC_LD_GET(_RUNGIEC_LD_N(p))), v)_RUNGIEC_LD_SET(_RUNGIEC_LD_N(p), _RUNGIEC_LD_GET(_RUNGIEC_LD_N(p)) + 1)}
{#define _RUNGIEC_LD_PUSH_1(p, v)}
(* jiepp drops a $n at the start or the end of a define body, so a body that starts with a line break begins with _RUNGIEC_LD_NL(), which expands to nothing. *)
{#define _RUNGIEC_LD_NL()}
(* XML of a set: the connections of an input, and the right power rail (nothing for an empty set). *)
{#define _RUNGIEC_LD_CONNS(p) _RUNGIEC_CAT_X(_RUNGIEC_LD_CN_, _RUNGIEC_LD_GET(_RUNGIEC_LD_N(p)))(p)}
{#define _RUNGIEC_LD_RAIL(p) _RUNGIEC_LD_SET(_rungiec_ld_t, _RUNGIEC_LD_GET(_RUNGIEC_LD_N(p)) > 0)_RUNGIEC_CAT_X(_RUNGIEC_LD_RAIL_, _RUNGIEC_LD_GET(_rungiec_ld_t))(p)}
{#define _RUNGIEC_LD_RAIL_0(p)}
{#define _RUNGIEC_LD_RAIL_1(p) _RUNGIEC_LD_NL()$n<LdObject xsi:type="RightPowerRail">_RUNGIEC_CAT_X(_RUNGIEC_LD_RC_, _RUNGIEC_LD_GET(_RUNGIEC_LD_N(p)))(p)</LdObject>}

(* Element output. id is the ID of the element (one __counter value, the same integer literal everywhere in the body), i the input set and o the output set of its depth. An element writes its object and sets o to its own ID. *)
{#define _RUNGIEC_LD_OP_E(kind, x, id, i, o) _RUNGIEC_LD_ONE(o, id)$n<LdObject xsi:type=kind operand=__xmlattr(x)><ConnectionPointIn>_RUNGIEC_LD_CONNS(i)</ConnectionPointIn><ConnectionPointOut connectionPointOutId=__xmlattr(id)/></LdObject>}
{#define _RUNGIEC_LD_CMP_E(op, a, b, id, i, o) _RUNGIEC_LD_ONE(o, id)$n<LdObject xsi:type="CompareContact" compareOperator=op operand1=__xmlattr(a) operand2=__xmlattr(b)><ConnectionPointIn>_RUNGIEC_LD_CONNS(i)</ConnectionPointIn><ConnectionPointOut connectionPointOutId=__xmlattr(id)/></LdObject>}
{#define _RUNGIEC_LD_CONTACT_E(x, id, i, o) _RUNGIEC_LD_OP_E("Contact", x, id, i, o)}
{#define _RUNGIEC_LD_NOT_CONTACT_E(x, id, i, o) _RUNGIEC_LD_OP_E("Contact" negated="true", x, id, i, o)}
{#define _RUNGIEC_LD_RISE_CONTACT_E(x, id, i, o) _RUNGIEC_LD_OP_E("Contact" edge="rising", x, id, i, o)}
{#define _RUNGIEC_LD_FALL_CONTACT_E(x, id, i, o) _RUNGIEC_LD_OP_E("Contact" edge="falling", x, id, i, o)}
{#define _RUNGIEC_LD_NOT_RISE_CONTACT_E(x, id, i, o) _RUNGIEC_LD_OP_E("Contact" negated="true" edge="rising", x, id, i, o)}
{#define _RUNGIEC_LD_NOT_FALL_CONTACT_E(x, id, i, o) _RUNGIEC_LD_OP_E("Contact" negated="true" edge="falling", x, id, i, o)}
{#define _RUNGIEC_LD_EQ_CONTACT_E(a, b, id, i, o) _RUNGIEC_LD_CMP_E("=", a, b, id, i, o)}
{#define _RUNGIEC_LD_NE_CONTACT_E(a, b, id, i, o) _RUNGIEC_LD_CMP_E("&lt;&gt;", a, b, id, i, o)}
{#define _RUNGIEC_LD_GT_CONTACT_E(a, b, id, i, o) _RUNGIEC_LD_CMP_E("&gt;", a, b, id, i, o)}
{#define _RUNGIEC_LD_GE_CONTACT_E(a, b, id, i, o) _RUNGIEC_LD_CMP_E("&gt;=", a, b, id, i, o)}
{#define _RUNGIEC_LD_LT_CONTACT_E(a, b, id, i, o) _RUNGIEC_LD_CMP_E("&lt;", a, b, id, i, o)}
{#define _RUNGIEC_LD_LE_CONTACT_E(a, b, id, i, o) _RUNGIEC_LD_CMP_E("&lt;=", a, b, id, i, o)}
{#define _RUNGIEC_LD_COIL_E(x, id, i, o) _RUNGIEC_LD_OP_E("Coil", x, id, i, o)}
{#define _RUNGIEC_LD_NOT_COIL_E(x, id, i, o) _RUNGIEC_LD_OP_E("Coil" negated="true", x, id, i, o)}
{#define _RUNGIEC_LD_SET_COIL_E(x, id, i, o) _RUNGIEC_LD_OP_E("Coil" latch="set", x, id, i, o)}
{#define _RUNGIEC_LD_RESET_COIL_E(x, id, i, o) _RUNGIEC_LD_OP_E("Coil" latch="reset", x, id, i, o)}
{#define _RUNGIEC_LD_RISE_COIL_E(x, id, i, o) _RUNGIEC_LD_OP_E("Coil" edge="rising", x, id, i, o)}
{#define _RUNGIEC_LD_FALL_COIL_E(x, id, i, o) _RUNGIEC_LD_OP_E("Coil" edge="falling", x, id, i, o)}
(* JMP and RETURN take no ID: the Jump and Return objects have only an input. They empty o, so the Rung does not reach the right power rail through them. *)
{#define _RUNGIEC_LD_JMP_E(x, i, o) _RUNGIEC_LD_CLR(o)$n<FbdObject xsi:type="Jump" targetNetworkLabel=__xmlattr(x)><ConnectionPointIn>_RUNGIEC_LD_CONNS(i)</ConnectionPointIn></FbdObject>}
{#define _RUNGIEC_LD_RETURN_E(i, o) _RUNGIEC_LD_CLR(o)$n<FbdObject xsi:type="Return"><ConnectionPointIn>_RUNGIEC_LD_CONNS(i)</ConnectionPointIn></FbdObject>}
(* MC and MCR: the depth as a DataSource of the input MCNo, then the Block (power input pin, MCNo, output ENO) and the right power rail on ENO. ds and eno are IDs (integer literals). *)
{#define _RUNGIEC_LD_MC_E(kind, pin, depth, ds, eno, i) _RUNGIEC_LD_NL()$n<FbdObject xsi:type="DataSource" identifier=__xmlattr(depth)><ConnectionPointOut connectionPointOutId=__xmlattr(ds)/></FbdObject>$n<FbdObject xsi:type="Block" typeName=kind><InputVariables><InputVariable parameterName=pin><ConnectionPointIn>_RUNGIEC_LD_CONNS(i)</ConnectionPointIn></InputVariable><InputVariable parameterName="MCNo"><ConnectionPointIn><Connection refConnectionPointOutId=__xmlattr(ds)/></ConnectionPointIn></InputVariable></InputVariables><OutputVariables><OutputVariable parameterName="ENO"><ConnectionPointOut connectionPointOutId=__xmlattr(eno)/></OutputVariable></OutputVariables></FbdObject>$n<LdObject xsi:type="RightPowerRail"><ConnectionPointIn><Connection refConnectionPointOutId=__xmlattr(eno)/></ConnectionPointIn></LdObject>}
(* A network node read by no WIRE goes to the right power rail (_RUNGIEC_LD_NET_RAIL, chosen by the read flag). *)
{#define _RUNGIEC_LD_NR_0(p) _RUNGIEC_LD_APPEND(p, _rungiec_ld_r)}
{#define _RUNGIEC_LD_NR_1(p)}
(* The start of a Rung: the Rung tag with the next evaluation order and the left power rail with the ID id. *)
{#define _RUNGIEC_LD_HEAD(id) <Rung evaluationOrder=__xmlattr(__counter(_rungiec_ld_rung))>$n<LdObject xsi:type="LeftPowerRail"><ConnectionPointOut connectionPointOutId=__xmlattr(id)/></LdObject>}

(* The public macros of the LD mode. They use the checks and counter updates of rungiec.iec, as the ST mode does. *)
(* The LD mode declares no work variables. BEGIN_RUNGIEC() starts the IDs and the evaluation order of the POU at 1 and writes the ld directive. END_RUNGIEC() writes the end directive, as in the ST mode. *)
{#define RUNGIEC_VAR()}
{#define RUNGIEC_VAR_TEMP()}
{#define RUNGIEC_VAR_NOEDGE()}
{#define BEGIN_RUNGIEC() _RUNGIEC_START()__counter_set(_rungiec_ld_id, 1)__counter_set(_rungiec_ld_rung, 1)${ld$}}
{#define END_RUNGIEC() _RUNGIEC_END() ${end$}}
(* RUNG: a Rung with the left power rail, the series of the children and the right power rail on the output set. *)
{#define RUNG(...) __assert(__counter_peek(rungiec_net) = 0, RUNGIEC RUNG inside BEGIN_NET and END_NET)_RUNGIEC_ARITY_CHECK(RUNG, __VA_ARGC__)_RUNGIEC_LD_RUNG_I(__counter(_rungiec_ld_id), __VA_ARGS__)}
{#define _RUNGIEC_LD_RUNG_I(id, ...) <Rung evaluationOrder=__xmlattr(__counter(_rungiec_ld_rung))>$n<LdObject xsi:type="LeftPowerRail"><ConnectionPointOut connectionPointOutId=__xmlattr(id)/></LdObject>_RUNGIEC_LD_ONE(_rungiec_ld_i0, id)_RUNGIEC_LD_EV0(_RUNGIEC_LD_SER_T (__VA_ARGS__))_RUNGIEC_LD_RAIL(_rungiec_ld_o0)$n</Rung>}
{#define SERIES(...) _RUNGIEC_ARITY_CHECK(SERIES, __VA_ARGC__)_RUNGIEC_LD_SER_T (__VA_ARGS__)}
{#define PARALLEL(...) _RUNGIEC_ARITY_CHECK(PARALLEL, __VA_ARGC__)_RUNGIEC_LD_PAR_T (__VA_ARGS__)}
(* An operand or a label is written into an XML attribute, so an empty one is checked when the element is written. *)
{#define _RUNGIEC_LD_EMPTY_CHECK(m, what, x) __assert(_RUNGIEC_COUNT(x) = 1, RUNGIEC LD: m has an empty what)}
{#define _RUNGIEC_LD_EMPTY_CHECK2(m, a, b) _RUNGIEC_LD_EMPTY_CHECK(m, operand, a)_RUNGIEC_LD_EMPTY_CHECK(m, operand, b)}
{#define CONTACT(x) _RUNGIEC_LD_EMPTY_CHECK(CONTACT, operand, x)_RUNGIEC_LD_CONTACT_T (x)}
{#define NOT_CONTACT(x) _RUNGIEC_LD_EMPTY_CHECK(NOT_CONTACT, operand, x)_RUNGIEC_LD_NOT_CONTACT_T (x)}
{#define RISE_CONTACT(x) _RUNGIEC_LD_EMPTY_CHECK(RISE_CONTACT, operand, x)_RUNGIEC_LD_EDGE(_RUNGIEC_LD_RISE_CONTACT_T, x, __counter(rungiec_edge))}
{#define FALL_CONTACT(x) _RUNGIEC_LD_EMPTY_CHECK(FALL_CONTACT, operand, x)_RUNGIEC_LD_EDGE(_RUNGIEC_LD_FALL_CONTACT_T, x, __counter(rungiec_edge))}
{#define NOT_RISE_CONTACT(x) _RUNGIEC_LD_EMPTY_CHECK(NOT_RISE_CONTACT, operand, x)_RUNGIEC_LD_EDGE(_RUNGIEC_LD_NOT_RISE_CONTACT_T, x, __counter(rungiec_edge))}
{#define NOT_FALL_CONTACT(x) _RUNGIEC_LD_EMPTY_CHECK(NOT_FALL_CONTACT, operand, x)_RUNGIEC_LD_EDGE(_RUNGIEC_LD_NOT_FALL_CONTACT_T, x, __counter(rungiec_edge))}
{#define EQ_CONTACT(a, b) _RUNGIEC_LD_EMPTY_CHECK2(EQ_CONTACT, a, b)_RUNGIEC_LD_EQ_CONTACT_T (a, b)}
{#define NE_CONTACT(a, b) _RUNGIEC_LD_EMPTY_CHECK2(NE_CONTACT, a, b)_RUNGIEC_LD_NE_CONTACT_T (a, b)}
{#define GT_CONTACT(a, b) _RUNGIEC_LD_EMPTY_CHECK2(GT_CONTACT, a, b)_RUNGIEC_LD_GT_CONTACT_T (a, b)}
{#define GE_CONTACT(a, b) _RUNGIEC_LD_EMPTY_CHECK2(GE_CONTACT, a, b)_RUNGIEC_LD_GE_CONTACT_T (a, b)}
{#define LT_CONTACT(a, b) _RUNGIEC_LD_EMPTY_CHECK2(LT_CONTACT, a, b)_RUNGIEC_LD_LT_CONTACT_T (a, b)}
{#define LE_CONTACT(a, b) _RUNGIEC_LD_EMPTY_CHECK2(LE_CONTACT, a, b)_RUNGIEC_LD_LE_CONTACT_T (a, b)}
{#define COIL(x) _RUNGIEC_LD_EMPTY_CHECK(COIL, operand, x)_RUNGIEC_LD_COIL_T (x)}
{#define NOT_COIL(x) _RUNGIEC_LD_EMPTY_CHECK(NOT_COIL, operand, x)_RUNGIEC_LD_NOT_COIL_T (x)}
{#define SET_COIL(x) _RUNGIEC_LD_EMPTY_CHECK(SET_COIL, operand, x)_RUNGIEC_LD_SET_COIL_T (x)}
{#define RESET_COIL(x) _RUNGIEC_LD_EMPTY_CHECK(RESET_COIL, operand, x)_RUNGIEC_LD_RESET_COIL_T (x)}
{#define RISE_COIL(x) _RUNGIEC_LD_EMPTY_CHECK(RISE_COIL, operand, x)_RUNGIEC_LD_EDGE(_RUNGIEC_LD_RISE_COIL_T, x, __counter(rungiec_edge))}
{#define FALL_COIL(x) _RUNGIEC_LD_EMPTY_CHECK(FALL_COIL, operand, x)_RUNGIEC_LD_EDGE(_RUNGIEC_LD_FALL_COIL_T, x, __counter(rungiec_edge))}
(* The statement macros below run the same checks and counter updates as the ST mode (the _RUNGIEC_*_CHECKS and _RUNGIEC_*_DONE macros of rungiec.iec); only the output differs. The LD mode has no run-time nesting trap: a statement macro written inside an element is the tag check PP91. *)
(* Networks: one Rung. BEGIN_NET() writes the Rung tag and the left power rail and sets node 0 to the rail and the other nodes empty. WIRE(from, to, ...) evaluates its series from the set of node from, marks node from as read and adds the output set to node to. Node numbers are integer literals (checked by _RUNGIEC_WIRE_CHECKS), so the node counter names are pasted from them. A node that no WIRE writes is empty: an element that reads it has no connection. END_NET() connects the nodes that no WIRE read to the right power rail (none: no right power rail). *)
{#define BEGIN_NET() _RUNGIEC_BEGIN_NET_CHECKS()_RUNGIEC_LD_BEGIN_NET_I(__counter(_rungiec_ld_id))}
{#define _RUNGIEC_LD_BEGIN_NET_I(id) _RUNGIEC_LD_HEAD(id)_RUNGIEC_LD_NET_CLEAR(id)}
{#define WIRE(from_node, to_node, ...) _RUNGIEC_WIRE_CHECKS(from_node, to_node, _RUNGIEC_COUNT(__VA_ARGS__))_RUNGIEC_LD_WIRE_I(_RUNGIEC_CAT_X(_rungiec_ld_n, from_node), _RUNGIEC_CAT_X(_rungiec_ld_nr, from_node), _RUNGIEC_CAT_X(_rungiec_ld_n, to_node), __VA_ARGS__)_RUNGIEC_WIRE_DONE(to_node)}
{#define _RUNGIEC_LD_WIRE_I(fn, fr, tn, ...) _RUNGIEC_LD_COPY(fn, _rungiec_ld_i0)_RUNGIEC_LD_SET(fr, 1)_RUNGIEC_LD_EV0(_RUNGIEC_LD_SER_T (__VA_ARGS__))_RUNGIEC_LD_APPEND(_rungiec_ld_o0, tn)}
{#define END_NET() _RUNGIEC_END_NET_CHECKS()_RUNGIEC_LD_NET_RAIL()_RUNGIEC_LD_RAIL(_rungiec_ld_r)$n</Rung>}
(* MC zones: BEGIN_MC(conditions...) is a Rung with the series of the conditions into the In input of an MC Block; END_MC() is a Rung with the left power rail into the EN input of an MCR Block. MCNo is the depth of the zone (0 for the outermost): rungiec_mc - 1 after the increment of BEGIN_MC and before the decrement of END_MC, made an integer token through _rungiec_ld_t. *)
{#define BEGIN_MC(...) _RUNGIEC_BEGIN_MC_CHECKS(__VA_ARGC__)_RUNGIEC_LD_BEGIN_MC_I(__counter(_rungiec_ld_id), __VA_ARGS__)}
{#define _RUNGIEC_LD_BEGIN_MC_I(id, ...) _RUNGIEC_LD_HEAD(id)_RUNGIEC_LD_ONE(_rungiec_ld_i0, id)_RUNGIEC_LD_EV0(_RUNGIEC_LD_SER_T (__VA_ARGS__))_RUNGIEC_LD_SET(_rungiec_ld_t, __counter_peek(rungiec_mc) - 1)_RUNGIEC_LD_MC_E("MC", "In", __counter_peek(_rungiec_ld_t), __counter(_rungiec_ld_id), __counter(_rungiec_ld_id), _rungiec_ld_o0)$n</Rung>}
{#define END_MC() _RUNGIEC_END_MC_CHECKS()_RUNGIEC_LD_SET(_rungiec_ld_t, __counter_peek(rungiec_mc) > 0)_RUNGIEC_CAT_X(_RUNGIEC_LD_MCR_NO_, _RUNGIEC_LD_GET(_rungiec_ld_t))()_RUNGIEC_LD_END_MC_I(__counter(_rungiec_ld_id))_RUNGIEC_END_MC_DONE()}
(* A counter cannot be negative, so an END_MC() without BEGIN_MC (already PP91) writes MCNo 0. *)
{#define _RUNGIEC_LD_MCR_NO_0() _RUNGIEC_LD_SET(_rungiec_ld_t, 0)}
{#define _RUNGIEC_LD_MCR_NO_1() _RUNGIEC_LD_SET(_rungiec_ld_t, __counter_peek(rungiec_mc) - 1)}
{#define _RUNGIEC_LD_END_MC_I(id) _RUNGIEC_LD_HEAD(id)_RUNGIEC_LD_ONE(_rungiec_ld_i0, id)_RUNGIEC_LD_MC_E("MCR", "EN", __counter_peek(_rungiec_ld_t), __counter(_rungiec_ld_id), __counter(_rungiec_ld_id), _rungiec_ld_i0)$n</Rung>}
(* JMP(label) and RETURN() run their checks when they are written (as the ST mode does) and become tags; the evaluation writes the Jump or Return object. LABEL(label) is a Rung with the label, the left power rail and a right power rail without connections. *)
{#define JMP(label) _RUNGIEC_LD_EMPTY_CHECK(JMP, label_name, label)_RUNGIEC_LD_JMP_I(label, _RUNGIEC_CAT_X(rungiec_label_, label), _RUNGIEC_CAT_X(rungiec_jump_, label))}
{#define _RUNGIEC_LD_JMP_I(label, lc, jc) _RUNGIEC_JMP_CHECKS(label, lc, jc)_RUNGIEC_LD_JMP_T (label)}
{#define RETURN() _RUNGIEC_RETURN_CHECKS()_RUNGIEC_LD_RETURN_T ()}
{#define LABEL(label) _RUNGIEC_LD_EMPTY_CHECK(LABEL, label_name, label)_RUNGIEC_LD_LABEL_I(label, _RUNGIEC_CAT_X(rungiec_label_, label), _RUNGIEC_CAT_X(rungiec_jump_, label))}
{#define _RUNGIEC_LD_LABEL_I(lbl, lc, jc) _RUNGIEC_LABEL_CHECKS(lbl, lc, jc)<Rung label=__xmlattr(lbl) evaluationOrder=__xmlattr(__counter(_rungiec_ld_rung))>$n<LdObject xsi:type="LeftPowerRail"><ConnectionPointOut connectionPointOutId=__xmlattr(__counter(_rungiec_ld_id))/></LdObject>$n<LdObject xsi:type="RightPowerRail"/>$n</Rung>}
(* Boxes: an FbdObject Block. A function block box has instanceName; its typeName is "" for FB_SCAN, FB_IN, FB_BOX, FB_EXEC and FB_ENO (jiecc fills in the type from the declaration of the instance) and the type argument for FBT_SCAN, FBT_IN, FBT_BOX, FBT_EXEC and FBT_ENO. A function box has typeName and no instanceName. FB_SCAN and FBT_SCAN have no power input; FB_IN, FBT_IN, FB_BOX and FBT_BOX connect the power to the input pin; the other boxes to EN. FB_BOX and FBT_BOX pass the output pin on; FB_ENO, FBT_ENO, FUN_ENO and FUN_ENO_RET pass ENO on; the other boxes pass their input set on unchanged. *)
(* The call arguments are named only: a := argument is a DataSource into an InputVariable, a => argument an OutputVariable into a DataSink. A positional argument is the jiepp error PP81 of the argument built-ins. *)
(* The names are checked when a box is written: an empty instance, type, function, pin or destination name, or more call arguments than the generated table holds, is PP91. *)
