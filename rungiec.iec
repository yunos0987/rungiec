(* rungiec.iec - ladder diagram DSL that jiepp expands to IEC 61131-3 ST (or, in the LD mode, to IEC 61131-10 LD XML). This is the entry file: it defines the common part (version, settings, checks, token pasting, node table) and includes the body of the mode at its end (rungiec_st.iec or rungiec_ld.iec); only the bodies define the public macros. Include this file, not a body. *)
(* Usage: see README.md, docs/GUIDE.md and docs/REFERENCE.md. A POU that uses the DSL has, after its var blocks, RUNGIEC_VAR() (or RUNGIEC_VAR_TEMP() / RUNGIEC_VAR_NOEDGE()), BEGIN_RUNGIEC(), the networks (RUNG, or BEGIN_NET with WIRE lines and END_NET) and END_RUNGIEC(). In the ST mode the statements go directly in the POU body, with no directive around them; in the LD mode BEGIN_RUNGIEC() opens the ld body and END_RUNGIEC() closes it. *)
{#pragma once}
(* RUNGIEC needs a jiepp whose diagnostic built-ins, named counters and comma-protecting built-in (used by ST_EXEC) are neither redefined nor undefined (the required jiepp version is in the tools section of README.md). There is no fallback. *)
(* A jiepp without the has_builtin operator stops at the first error. A bare not is a bitwise not in a condition, so the C logical operators (&&, || and !) are used. The messages name no built-in, because a redefined built-in would be expanded in them. *)
{#ifndef __has_builtin}
{#error RUNGIEC needs a jiepp with the built-in assert, named counters and comma protection, neither redefined nor undefined; use the jiepp version named in README.md}
{#elif !__has_builtin(__assert) || !__has_builtin(__counter) || !__has_builtin(__counter_peek) || !__has_builtin(__counter_set) || !__has_builtin(__nosplit)}
{#error RUNGIEC needs a jiepp with the built-in assert, named counters and comma protection, neither redefined nor undefined; use the jiepp version named in README.md}
{#endif}
(* jiecc defines _JIECC_FULL_VER (plain jiepp does not). Both modes need Jiecc 9.4.0: the ST mode writes the statements directly in the POU body. *)
{#if defined(_JIECC_FULL_VER) && _JIECC_FULL_VER < 90400}
{#error RUNGIEC needs Jiecc 9.4.0 or later}
{#endif}
(* Version: RUNGIEC_VERSION = major * 10000 + minor * 100 + revision (same scheme as _JIEPP_FULL_VER). *)
{#define RUNGIEC_VERSION_MAJOR 0}
{#define RUNGIEC_VERSION_MINOR 3}
{#define RUNGIEC_VERSION_REVISION 0}
{#define RUNGIEC_VERSION 300}
{#if RUNGIEC_VERSION <> RUNGIEC_VERSION_MAJOR * 10000 + RUNGIEC_VERSION_MINOR * 100 + RUNGIEC_VERSION_REVISION}
{#error RUNGIEC internal error: RUNGIEC_VERSION does not match its parts}
{#endif}
{#ifndef RUNGIEC_NEST_MAX}
{#define RUNGIEC_NEST_MAX 16}
{#endif}
{#ifndef RUNGIEC_EDGE_MAX}
{#define RUNGIEC_EDGE_MAX 64}
{#endif}
{#ifndef RUNGIEC_ARITY_MAX}
{#define RUNGIEC_ARITY_MAX 16}
{#endif}
{#ifndef RUNGIEC_NODE_MAX}
{#define RUNGIEC_NODE_MAX 16}
{#endif}
{#ifndef RUNGIEC_MC_MAX}
{#define RUNGIEC_MC_MAX 15}
{#endif}
{#if RUNGIEC_ARITY_MAX < 1 || RUNGIEC_ARITY_MAX > 32}
{#error RUNGIEC arity limit RUNGIEC_ARITY_MAX is out of range 1 to 32}
{#endif}
(* RUNGIEC_NEST_MAX, RUNGIEC_EDGE_MAX, RUNGIEC_NODE_MAX and RUNGIEC_MC_MAX are integer literals (array bounds; jiecc 9.4.0 also reads an expression of integer literals correctly); only the range is checked here. RUNGIEC_NODE_MAX is 64 or less because the node table below ends at node 64. *)
{#if RUNGIEC_NEST_MAX < 1}
{#error RUNGIEC nest limit RUNGIEC_NEST_MAX must be an integer literal of 1 or more}
{#endif}
{#if RUNGIEC_EDGE_MAX < 1}
{#error RUNGIEC edge slot count RUNGIEC_EDGE_MAX must be an integer literal of 1 or more}
{#endif}
{#if RUNGIEC_NODE_MAX < 1}
{#error RUNGIEC node limit RUNGIEC_NODE_MAX must be an integer literal of 1 or more}
{#endif}
{#if RUNGIEC_NODE_MAX > 64}
{#error RUNGIEC node limit RUNGIEC_NODE_MAX exceeds 64, the largest node number of the node table}
{#endif}
{#if RUNGIEC_MC_MAX < 1}
{#error RUNGIEC MC nesting limit RUNGIEC_MC_MAX must be an integer literal of 1 or more}
{#endif}
{#if defined(RUNGIEC_LD) && RUNGIEC_LD}
(* LD mode: RUNGIEC_LD defined and nonzero (jiecc or jiepp -D RUNGIEC_LD, or a define of RUNGIEC_LD to 1 before the include of rungiec.iec). The public macros write the IEC 61131-10 LD XML of Rung objects into the ld body instead of ST (rungiec_ld.iec, included at the end of this file). *)
{#define _RUNGIEC_LD 1}
{#else}
{#define _RUNGIEC_LD 0}
{#endif}

(* Preprocessor counters (jiepp named counters, not ST variables): rungiec_edge = next edge slot of this POU, rungiec_net = 1 between BEGIN_NET() and END_NET(), rungiec_node = to node of the previous WIRE, rungiec_mc = depth of the open MC zones, rungiec_open = 1 between BEGIN_RUNGIEC() and END_RUNGIEC(), rungiec_exit = 1 after a WIRE of the open network that has JMP() or RETURN() (BEGIN_NET() sets it to 0, see WIRE). BEGIN_RUNGIEC() sets the others for every POU (through _RUNGIEC_START); END_RUNGIEC() sets rungiec_open, rungiec_net and rungiec_mc back to 0, so an error is not reported again by the next POU. *)
(* Segment counters for JMP and LABEL: rungiec_seg = number of the current MC segment, counted over the whole file and never reset (BEGIN_RUNGIEC(), BEGIN_MC and END_MC each start a new segment); rungiec_pou = the first segment of this POU. For each label L, rungiec_label_L = the segment of LABEL(L) and rungiec_jump_L = the segment of the last JMP(L); a value below rungiec_pou belongs to an earlier POU (an unused counter is 0). *)
(* The checks and counter updates of BEGIN_RUNGIEC() (_RUNGIEC_START) and END_RUNGIEC() (_RUNGIEC_END). *)
{#define _RUNGIEC_START() __assert(__counter_peek(rungiec_net) = 0, RUNGIEC END_NET and END_RUNGIEC are missing before the next BEGIN_RUNGIEC) __assert(__counter_peek(rungiec_mc) = 0, RUNGIEC END_MC and END_RUNGIEC are missing before the next BEGIN_RUNGIEC) __assert(__counter_peek(rungiec_open) = 0, RUNGIEC END_RUNGIEC is missing before BEGIN_RUNGIEC) __counter_set(rungiec_open, 1) __counter_set(rungiec_seg, __counter_peek(rungiec_seg) + 1) __counter_set(rungiec_pou, __counter_peek(rungiec_seg)) __counter_set(rungiec_edge, 1) __counter_set(rungiec_net, 0) __counter_set(rungiec_node, 0) __counter_set(rungiec_mc, 0)}
{#define _RUNGIEC_END() __assert(__counter_peek(rungiec_open) = 1, RUNGIEC BEGIN_RUNGIEC is missing before END_RUNGIEC) __assert(__counter_peek(rungiec_net) = 0, RUNGIEC END_NET is missing before END_RUNGIEC) __assert(__counter_peek(rungiec_mc) = 0, RUNGIEC END_MC is missing before END_RUNGIEC) __counter_set(rungiec_open, 0) __counter_set(rungiec_net, 0) __counter_set(rungiec_mc, 0)}

(* Token pasting helpers. __VA_ARGC__ and counter calls must go through _RUNGIEC_CAT_X (an operand of @@ is not expanded). *)
{#define _RUNGIEC_CAT(a, b) a@@b}
{#define _RUNGIEC_CAT_X(a, b) _RUNGIEC_CAT(a, b)}
(* _RUNGIEC_CAT3_X pastes a to the first token of b and c to the last token of b (an argument of several tokens keeps its middle tokens). *)
{#define _RUNGIEC_CAT3(a, b, c) a@@b@@c}
{#define _RUNGIEC_CAT3_X(a, b, c) _RUNGIEC_CAT3(a, b, c)}
(* Checks. Each expands to nothing; a failed check is the preprocessing error PP91 with the message. *)
{#define _RUNGIEC_COUNT(...) __VA_ARGC__}
{#define _RUNGIEC_ARITY_CHECK(name, count) __assert(count >= 1 && count <= RUNGIEC_ARITY_MAX, RUNGIEC name has count elements, allowed 1 to RUNGIEC_ARITY_MAX)}
(* The edge slot check of the edge contacts and transition coils. *)
{#define _RUNGIEC_EDGE_CHECK(n) __assert(n <= RUNGIEC_EDGE_MAX, RUNGIEC edge slot n exceeds RUNGIEC_EDGE_MAX, the edge contacts and transition coils of this POU need more slots)}

(* The checks and counter updates of the statement macros RETURN, JMP, BEGIN_MC, END_MC and LABEL. The checks of JMP and LABEL read _RUNGIEC_JUMP_OK, which the body of each mode defines; it is read when JMP or LABEL is expanded, after the body has been included. *)
{#define _RUNGIEC_RETURN_CHECKS() __counter_set(rungiec_exit, __counter_peek(rungiec_exit) + 2 * __counter_peek(rungiec_net))}
{#define _RUNGIEC_JMP_CHECKS(label, lc, jc) __assert(_RUNGIEC_JUMP_OK = 1, RUNGIEC JMP to label is not supported for the jiecc targets omron, keyence and mitsubishi) __assert(__counter_peek(lc) < __counter_peek(rungiec_pou) || __counter_peek(lc) = __counter_peek(rungiec_seg), RUNGIEC JMP to label goes back across BEGIN_MC or END_MC) __assert(__counter_peek(lc) >= __counter_peek(rungiec_pou) || __counter_peek(jc) < __counter_peek(rungiec_pou) || __counter_peek(jc) = __counter_peek(rungiec_seg), RUNGIEC JMP to label and an earlier JMP to label are on different sides of BEGIN_MC or END_MC) __counter_set(jc, __counter_peek(rungiec_seg)) __counter_set(rungiec_exit, __counter_peek(rungiec_exit) + 2 * __counter_peek(rungiec_net))}
{#define _RUNGIEC_BEGIN_MC_CHECKS(count) __assert(__counter_peek(rungiec_net) = 0, RUNGIEC BEGIN_MC inside BEGIN_NET and END_NET) __assert(__counter_peek(rungiec_mc) < RUNGIEC_MC_MAX, RUNGIEC BEGIN_MC nesting exceeds RUNGIEC_MC_MAX) _RUNGIEC_ARITY_CHECK(BEGIN_MC, count) __counter_set(rungiec_mc, __counter_peek(rungiec_mc) + 1) __counter_set(rungiec_seg, __counter_peek(rungiec_seg) + 1)}
{#define _RUNGIEC_END_MC_CHECKS() __assert(__counter_peek(rungiec_net) = 0, RUNGIEC END_MC inside BEGIN_NET and END_NET) __assert(__counter_peek(rungiec_mc) > 0, RUNGIEC END_MC without BEGIN_MC)}
{#define _RUNGIEC_END_MC_DONE() __counter_set(rungiec_mc, __counter_peek(rungiec_mc) - 1) __counter_set(rungiec_seg, __counter_peek(rungiec_seg) + 1)}
{#define _RUNGIEC_LABEL_CHECKS(label, lc, jc) __assert(_RUNGIEC_JUMP_OK = 1, RUNGIEC LABEL label is not supported for the jiecc targets omron, keyence and mitsubishi) __assert(__counter_peek(rungiec_net) = 0, RUNGIEC LABEL inside BEGIN_NET and END_NET) __assert(__counter_peek(lc) < __counter_peek(rungiec_pou), RUNGIEC LABEL label is defined twice in this POU) __assert(__counter_peek(jc) < __counter_peek(rungiec_pou) || __counter_peek(jc) = __counter_peek(rungiec_seg), RUNGIEC JMP to label goes forward across BEGIN_MC or END_MC) __counter_set(lc, __counter_peek(rungiec_seg))}

(* Node table: K = 0..64, generated by tools/gen_arity_table.py --nodes. Do not edit by hand. *)
(* WIRE looks a node number up as _RUNGIEC_IS_NODE_ @@ number @@ 0, so only the integer literals 0 to 64 hit the table. *)
{#define _RUNGIEC_IS_NODE_00 1}
{#define _RUNGIEC_IS_NODE_10 1}
{#define _RUNGIEC_IS_NODE_20 1}
{#define _RUNGIEC_IS_NODE_30 1}
{#define _RUNGIEC_IS_NODE_40 1}
{#define _RUNGIEC_IS_NODE_50 1}
{#define _RUNGIEC_IS_NODE_60 1}
{#define _RUNGIEC_IS_NODE_70 1}
{#define _RUNGIEC_IS_NODE_80 1}
{#define _RUNGIEC_IS_NODE_90 1}
{#define _RUNGIEC_IS_NODE_100 1}
{#define _RUNGIEC_IS_NODE_110 1}
{#define _RUNGIEC_IS_NODE_120 1}
{#define _RUNGIEC_IS_NODE_130 1}
{#define _RUNGIEC_IS_NODE_140 1}
{#define _RUNGIEC_IS_NODE_150 1}
{#define _RUNGIEC_IS_NODE_160 1}
{#define _RUNGIEC_IS_NODE_170 1}
{#define _RUNGIEC_IS_NODE_180 1}
{#define _RUNGIEC_IS_NODE_190 1}
{#define _RUNGIEC_IS_NODE_200 1}
{#define _RUNGIEC_IS_NODE_210 1}
{#define _RUNGIEC_IS_NODE_220 1}
{#define _RUNGIEC_IS_NODE_230 1}
{#define _RUNGIEC_IS_NODE_240 1}
{#define _RUNGIEC_IS_NODE_250 1}
{#define _RUNGIEC_IS_NODE_260 1}
{#define _RUNGIEC_IS_NODE_270 1}
{#define _RUNGIEC_IS_NODE_280 1}
{#define _RUNGIEC_IS_NODE_290 1}
{#define _RUNGIEC_IS_NODE_300 1}
{#define _RUNGIEC_IS_NODE_310 1}
{#define _RUNGIEC_IS_NODE_320 1}
{#define _RUNGIEC_IS_NODE_330 1}
{#define _RUNGIEC_IS_NODE_340 1}
{#define _RUNGIEC_IS_NODE_350 1}
{#define _RUNGIEC_IS_NODE_360 1}
{#define _RUNGIEC_IS_NODE_370 1}
{#define _RUNGIEC_IS_NODE_380 1}
{#define _RUNGIEC_IS_NODE_390 1}
{#define _RUNGIEC_IS_NODE_400 1}
{#define _RUNGIEC_IS_NODE_410 1}
{#define _RUNGIEC_IS_NODE_420 1}
{#define _RUNGIEC_IS_NODE_430 1}
{#define _RUNGIEC_IS_NODE_440 1}
{#define _RUNGIEC_IS_NODE_450 1}
{#define _RUNGIEC_IS_NODE_460 1}
{#define _RUNGIEC_IS_NODE_470 1}
{#define _RUNGIEC_IS_NODE_480 1}
{#define _RUNGIEC_IS_NODE_490 1}
{#define _RUNGIEC_IS_NODE_500 1}
{#define _RUNGIEC_IS_NODE_510 1}
{#define _RUNGIEC_IS_NODE_520 1}
{#define _RUNGIEC_IS_NODE_530 1}
{#define _RUNGIEC_IS_NODE_540 1}
{#define _RUNGIEC_IS_NODE_550 1}
{#define _RUNGIEC_IS_NODE_560 1}
{#define _RUNGIEC_IS_NODE_570 1}
{#define _RUNGIEC_IS_NODE_580 1}
{#define _RUNGIEC_IS_NODE_590 1}
{#define _RUNGIEC_IS_NODE_600 1}
{#define _RUNGIEC_IS_NODE_610 1}
{#define _RUNGIEC_IS_NODE_620 1}
{#define _RUNGIEC_IS_NODE_630 1}
{#define _RUNGIEC_IS_NODE_640 1}

(* The checks and counter updates of BEGIN_NET, WIRE and END_NET. WIRE checks its node numbers with the node table above. *)
{#define _RUNGIEC_BEGIN_NET_CHECKS() __assert(__counter_peek(rungiec_net) = 0, RUNGIEC BEGIN_NET inside BEGIN_NET and END_NET, END_NET is missing) __counter_set(rungiec_net, 1) __counter_set(rungiec_node, 0) __counter_set(rungiec_exit, 0)}
{#define _RUNGIEC_WIRE_CHECKS(from_node, to_node, count) __assert(__counter_peek(rungiec_net) = 1, RUNGIEC WIRE outside BEGIN_NET and END_NET) __assert(__counter_peek(rungiec_exit) mod 2 = 0, RUNGIEC WIRE after a WIRE that jumps or returns, write that WIRE last before END_NET) __assert(_RUNGIEC_CAT3_X(_RUNGIEC_IS_NODE_, from_node, 0) = 1, RUNGIEC WIRE from node from_node is not an integer literal from 0 to 64) __assert(_RUNGIEC_CAT3_X(_RUNGIEC_IS_NODE_, to_node, 0) = 1, RUNGIEC WIRE to node to_node is not an integer literal from 0 to 64) __assert(from_node >= 0 && from_node < to_node, RUNGIEC WIRE from node from_node must be 0 or more and less than to node to_node) __assert(to_node <= RUNGIEC_NODE_MAX, RUNGIEC WIRE to node to_node exceeds RUNGIEC_NODE_MAX) __assert(to_node >= __counter_peek(rungiec_node), RUNGIEC WIRE to node to_node must not be less than __counter_peek(rungiec_node), the to node of the previous WIRE) _RUNGIEC_ARITY_CHECK(WIRE, count)}
{#define _RUNGIEC_WIRE_DONE(to_node) __counter_set(rungiec_node, to_node) __counter_set(rungiec_exit, __counter_peek(rungiec_exit) > 0)}
{#define _RUNGIEC_END_NET_CHECKS() __assert(__counter_peek(rungiec_net) = 1, RUNGIEC END_NET without BEGIN_NET) __counter_set(rungiec_net, 0)}

(* The body of the mode defines the public macros: rungiec_ld.iec writes the LD XML (LD mode), rungiec_st.iec writes ST. Both bodies use the checks and counter updates above: _RUNGIEC_START, _RUNGIEC_END, _RUNGIEC_ARITY_CHECK, _RUNGIEC_EDGE_CHECK and those of the statement macros. The LD mode needs the XML and argument built-ins of jiepp, so without them neither body is read. *)
{#if _RUNGIEC_LD = 1 && (!__has_builtin(__xmlattr) || !__has_builtin(__xmltext) || !__has_builtin(__arg_lhs) || !__has_builtin(__arg_rhs) || !__has_builtin(__arg_dir))}
{#error RUNGIEC LD mode needs a jiepp with the XML and argument built-ins; use the jiepp version named in README.md}
{#elif _RUNGIEC_LD = 1}
{#include 'rungiec_ld.iec'}
{#else}
{#include 'rungiec_st.iec'}
{#endif}
