(* @expect pp-error PP91.*arity limit 33 is out of range 1 to 32 *)
(* @cycles 1 *)
(* Purpose: RUNGIEC_ARITY_MAX 33 is above the hard limit 32 and is rejected when rungiec.iec is included. *)
{#define RUNGIEC_ARITY_MAX 33}
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--( Y )--|  *)
RUNG(CONTACT(A), COIL(Y))
END_RUNGIEC()
end_program
