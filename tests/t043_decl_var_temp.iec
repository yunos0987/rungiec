(* @expect pass *)
(* @cycles 16 *)
(* Purpose: RUNGIEC_VAR_TEMP() in a PROGRAM and in a function block with an internal DSL: nesting, RISE_CONTACT over several scans, FB_EXEC call, idle stack. *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t043_decl_var_temp))
function_block TempFb
var_input a1, b1: bool; end_var
var_output q, r: bool; end_var
RUNGIEC_VAR_TEMP()
BEGIN_RUNGIEC()
(*  |--| a1 |--| b1 |--( q )--|  *)
RUNG(CONTACT(a1), CONTACT(b1), COIL(q))
(*  |--|P b1 |--( r )--|  *)
RUNG(RISE_CONTACT(b1), COIL(r))
END_RUNGIEC()
end_function_block
TEST_M(t043_decl_var_temp)
var
    A, B, C, D, Y1, Y2, Y3, PrevA, PrevC: bool;
    Fb0, Fb1: TempFb;
    InA: array[1..16] of bool := [false, true, false, true, false, true, false, true, false, true, false, true, false, true, false, true];
    InB: array[1..16] of bool := [false, false, true, true, false, false, true, true, false, false, true, true, false, false, true, true];
    InC: array[1..16] of bool := [false, false, false, false, true, true, true, true, false, false, false, false, true, true, true, true];
    InD: array[1..16] of bool := [false, false, false, false, false, false, false, false, true, true, true, true, true, true, true, true];
    Cyc: dint;
end_var
RUNGIEC_VAR_TEMP()
BEGIN_RUNGIEC()
T_BEGIN()
A := InA[Cyc]; B := InB[Cyc]; C := InC[Cyc]; D := InD[Cyc];
(*  |--+--| A |--| B |--+--( Y1 )--|  *)
(*  |  |                |          |  *)
(*  |  +--| C |--| D |--+          |  *)
RUNG(PARALLEL(SERIES(CONTACT(A), CONTACT(B)), SERIES(CONTACT(C), CONTACT(D))), COIL(Y1))
EXPECT_TRUE(Y1 = ((A and B) or (C and D)), 'y1_nested');
T_EXPECT_IDLE(idle_after_y1);
(*  |--|P A |--( Y2 )--|  *)
RUNG(RISE_CONTACT(A), COIL(Y2))
EXPECT_TRUE(Y2 = (A and (not PrevA)), 'y2_rise_over_scans');
T_EXPECT_IDLE(idle_after_y2);
(*  |--| A |--[ Fb1(a1 := B, b1 := C) ]--| Fb1.q |--( Y3 )--|  *)
RUNG(CONTACT(A), FB_EXEC(Fb1, a1 := B, b1 := C), CONTACT(Fb1.q), COIL(Y3))
EXPECT_TRUE(Y3 = (A and B and C), 'y3_through_fb_with_var_temp');
T_EXPECT_IDLE(idle_after_y3);
(*  Fb0 is called on every scan; its edge contact sees b1 = C  *)
Fb0(a1 := B, b1 := C);
EXPECT_TRUE(Fb0.q = (B and C), 'fb_series_q');
EXPECT_TRUE(Fb0.r = (C and (not PrevC)), 'fb_rise_over_scans');
PrevA := A;
PrevC := C;
END_RUNGIEC()
END_TEST_M
