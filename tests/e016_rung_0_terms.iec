(* @expect pp-error PP91: .RUNGIEC RUNG has 0 elements, allowed 1 to 16 *)
(* @cycles 1 *)
(* Purpose: RUNG() with no term is a preprocessing error (RUNG checks its own arity). *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--( Y )--|  *)
RUNG()
END_RUNGIEC()
end_program
