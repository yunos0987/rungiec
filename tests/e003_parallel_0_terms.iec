(* @expect pp-error PP91: .RUNGIEC PARALLEL has 0 elements, allowed 1 to 16 *)
(* @cycles 1 *)
(* Purpose: PARALLEL() with no term is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--( Y )--|  *)
RUNG(PARALLEL())
END_RUNGIEC()
end_program
