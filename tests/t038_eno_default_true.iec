(* @expect pass *)
(* @cycles 3 *)
(* Purpose: A function and an FB that never assign eno return ENO = TRUE (IEC 6.6.1.5): the power after an *_ENO box is ON when it was executed and OFF when the power was OFF. *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t038_eno_default_true))
function Bump : dint
var_in_out cnt: dint; end_var
cnt := cnt + 1;
Bump := cnt;
end_function
function_block EnoFb
var_output n: dint; end_var
n := n + 1;
end_function_block
TEST_M(t038_eno_default_true)
var
    P, Y1, Y2: bool;
    N1: dint;
    Fb0: EnoFb;
    InP: array[1..3] of bool := [false, true, true];
    ExpN: array[1..3] of dint := [0, 1, 2];
    Cyc: dint;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
T_BEGIN()
P := InP[Cyc];
(*  |--| P |--[ Bump(cnt := N1) ENO ]--( Y1 )--|   eno never assigned  *)
RUNG(CONTACT(P), FUN_ENO(Bump, cnt := N1), COIL(Y1))
(*  |--| P |--[ Fb0 ENO ]--( Y2 )--|   eno never assigned  *)
RUNG(CONTACT(P), FB_ENO(Fb0), COIL(Y2))
EXPECT_TRUE(N1 = ExpN[Cyc], 'function_still_executed');
EXPECT_TRUE(Fb0.n = ExpN[Cyc], 'fb_still_executed');
EXPECT_TRUE(Y1 = P, 'power_after_function_box_is_on_when_executed');
EXPECT_TRUE(Y2 = P, 'power_after_fb_box_is_on_when_executed');
T_EXPECT_IDLE(idle_after_nets);
END_RUNGIEC()
END_TEST_M
