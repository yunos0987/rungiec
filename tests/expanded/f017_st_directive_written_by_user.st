(* @expect run-error INVALID_SYNTAX_FOR_CODEBLOCK *)
(* @cycles 1 *)
(* Purpose: A POU that uses the DSL and has an st directive line of the user between RUNGIEC_VAR() and BEGIN_RUNGIEC() opens an ST block that nothing closes (the statements go directly in the POU body and END_RUNGIEC() writes no end directive), so jiecc reports a syntax error (jiecc compile stage). *)
(* @lint-allow LN16 *)
(* rungiec.iec - ladder diagram DSL that jiepp expands to IEC 61131-3 ST (or, in the LD mode, to IEC 61131-10 LD XML). This is the entry file: it defines the common part (version, settings, checks, token pasting, node table) and includes the body of the mode at its end (rungiec_st.iec or rungiec_ld.iec); only the bodies define the public macros. Include this file, not a body. *)
(* Usage: see README.md, docs/GUIDE.md and docs/REFERENCE.md. A POU that uses the DSL has, after its var blocks, RUNGIEC_VAR() (or RUNGIEC_VAR_TEMP() / RUNGIEC_VAR_NOEDGE()), BEGIN_RUNGIEC(), the networks (RUNG, or BEGIN_NET with WIRE lines and END_NET) and END_RUNGIEC(). In the ST mode the statements go directly in the POU body, with no directive around them; in the LD mode BEGIN_RUNGIEC() opens the ld body and END_RUNGIEC() closes it. *)
(* RUNGIEC needs a jiepp whose diagnostic built-ins, named counters and comma-protecting built-in (used by ST_EXEC) are neither redefined nor undefined (the required jiepp version is in the tools section of README.md). There is no fallback. *)
(* A jiepp without the has_builtin operator stops at the first error. A bare not is a bitwise not in a condition, so the logical form with backslashes is used. The messages name no built-in, because a redefined built-in would be expanded in them. *)
(* jiecc defines _JIECC_FULL_VER (plain jiepp does not). Both modes need Jiecc 9.2.0: the ST mode writes the statements directly in the POU body. *)
(* Version: RUNGIEC_VERSION = major * 10000 + minor * 100 + revision (same scheme as _JIEPP_FULL_VER). *)
(* RUNGIEC_NEST_MAX, RUNGIEC_EDGE_MAX, RUNGIEC_NODE_MAX and RUNGIEC_MC_MAX are integer literals (array bounds; jiecc 9.2.0 also reads an expression of integer literals correctly); only the range is checked here. RUNGIEC_NODE_MAX is 64 or less because the node table below ends at node 64. *)
(* Preprocessor counters (jiepp named counters, not ST variables): rungiec_edge = next edge slot of this POU, rungiec_net = 1 between BEGIN_NET() and END_NET(), rungiec_node = to node of the previous WIRE, rungiec_mc = depth of the open MC zones, rungiec_open = 1 between BEGIN_RUNGIEC() and END_RUNGIEC(), rungiec_exit = 1 after a WIRE of the open network that has JMP() or RETURN() (BEGIN_NET() sets it to 0, see WIRE). BEGIN_RUNGIEC() sets the others for every POU (through _RUNGIEC_START); END_RUNGIEC() sets rungiec_open, rungiec_net and rungiec_mc back to 0, so an error is not reported again by the next POU. *)
(* Segment counters for JMP and LABEL: rungiec_seg = number of the current MC segment, counted over the whole file and never reset (BEGIN_RUNGIEC(), BEGIN_MC and END_MC each start a new segment); rungiec_pou = the first segment of this POU. For each label L, rungiec_label_L = the segment of LABEL(L) and rungiec_jump_L = the segment of the last JMP(L); a value below rungiec_pou belongs to an earlier POU (an unused counter is 0). *)
(* The checks and counter updates of BEGIN_RUNGIEC() (_RUNGIEC_START) and END_RUNGIEC() (_RUNGIEC_END). *)
(* Token pasting helpers. __VA_ARGC__ and counter calls must go through _RUNGIEC_CAT_X (an operand of @@ is not expanded). *)
(* _RUNGIEC_CAT3_X pastes a to the first token of b and c to the last token of b (an argument of several tokens keeps its middle tokens). *)
(* Checks. Each expands to nothing; a failed check is the preprocessing error PP91 with the message. *)
(* The edge slot check of the edge contacts and transition coils. *)
(* The checks and counter updates of the statement macros RETURN, JMP, BEGIN_MC, END_MC and LABEL. The checks of JMP and LABEL read _RUNGIEC_JUMP_OK, which the body of each mode defines; it is read when JMP or LABEL is expanded, after the body has been included. *)
(* Node table: K = 0..64, generated by tools/gen_arity_table.py --nodes. Do not edit by hand. *)
(* WIRE looks a node number up as _RUNGIEC_IS_NODE_ @@ number @@ 0, so only the integer literals 0 to 64 hit the table. *)
(* The checks and counter updates of BEGIN_NET, WIRE and END_NET. WIRE checks its node numbers with the node table above. *)
(* The body of the mode defines the public macros: rungiec_ld.iec writes the LD XML (LD mode), rungiec_st.iec writes ST. Both bodies use the checks and counter updates above: _RUNGIEC_START, _RUNGIEC_END, _RUNGIEC_ARITY_CHECK, _RUNGIEC_EDGE_CHECK and those of the statement macros. The LD mode needs the XML and argument built-ins of jiepp, so without them neither body is read. *)
(* rungiec_st.iec - the ST mode of RUNGIEC: the public macros expand to IEC 61131-3 ST. *)
(* rungiec.iec includes this file at its end in the ST mode (RUNGIEC_LD not defined or zero); include rungiec.iec, not this file. The checks and counter updates that both modes share, the settings and the node table are in rungiec.iec. *)
(* Working variable declarations. RungiecPrev is always static (var), never var_temp. *)
(* RungiecSp starts at -1 so that a POU whose BEGIN_RUNGIEC() init statements did not run faults on the first push (RungiecStIn[0] is out of bounds); the init statements set it to 0. *)
(* RungiecRail is the left power rail: TRUE, or the condition of the innermost open MC zone. RungiecNode holds the node values of a BEGIN_NET network (node 0 = rail); BEGIN_NET() clears nodes 1 and up with the loop index RungiecI. RungiecMcSt[d] keeps the rail outside the MC zone of depth d. *)
(* POU layout. After the user's own var blocks, write RUNGIEC_VAR() (or RUNGIEC_VAR_TEMP() / RUNGIEC_VAR_NOEDGE()), BEGIN_RUNGIEC(), the networks and END_RUNGIEC(). The statements go directly in the POU body (Jiecc 9.2.0 reads them as ST); neither the user nor these macros write a directive around them. *)
(* RUNGIEC_VAR(): the work variables and RungiecPrev, all in a var block. RUNGIEC_VAR_TEMP(): the work variables are var_temp (RungiecPrev stays static var). RUNGIEC_VAR_NOEDGE(): for a FUNCTION or METHOD; no RungiecPrev, so no edge contacts or transition coils. *)
(* BEGIN_RUNGIEC() and END_RUNGIEC() are common to the three. BEGIN_RUNGIEC() checks that the previous POU closed its networks, its MC zones and its BEGIN_RUNGIEC(), resets the counters (_RUNGIEC_START), then writes the init statements. END_RUNGIEC() checks that BEGIN_RUNGIEC() came before it and that every BEGIN_NET and BEGIN_MC of the POU is closed (_RUNGIEC_END); it expands to no ST. *)
(* Combinator stack handling. Elements and combinators end without ';' and their last statement is an assignment, *)
(* so two children written without a comma between them are a jiecc syntax error. The parent adds the ';'. *)
(* Arity table: N = 1..32, generated by tools/gen_arity_table.py. Do not edit by hand. The arity limit is checked by _RUNGIEC_ARITY_CHECK. *)
(* Contacts. The operand is evaluated exactly once, regardless of the power flow. A contact gives its input power and its condition (RungiecEn and ...), so the series copies the value of each child (RungiecAcc := RungiecVal). *)
(* Edge contacts and transition-sensing coils. Each call site takes the next slot of RungiecPrev through __counter(rungiec_edge), which BEGIN_RUNGIEC() restarts at 1 in every POU. *)
(* jiepp expands an argument once per call, so n is the same integer literal everywhere in the body. The previous value is updated on every scan, regardless of the power flow. *)
(* Coils. The power after a coil is its own input power (IEC 61131-3 8.2.5 pass-through). NOT_COIL writes FALSE while the left rail is OFF (OFF MC zone). *)
(* Comparison contacts. Each operand is evaluated exactly once, regardless of the power flow. *)
(* Function and function block calls. All box macros take call syntax only: an instance or function name, then the call arguments. *)
(* FB_SCAN(inst, args...): called on every scan, whatever the power and whatever the left rail. The power after the box equals the power before it. *)
(* FB_IN(inst, pin, args...): called on every scan with the power connected to the input pin (IN of TON, CU of CTU, CLK of R_TRIG). The power after the box equals the power before it, so read inst.Q with CONTACT; for TOF, TP and counters read it in a separate RUNG. *)
(* FB_BOX(inst, in_pin, out_pin, args...): called on every scan with the power connected to the input pin in_pin; the power after the box is the output inst.out_pin (the box of IEC 61131-3: it replaces the power before the box, also when it is TRUE without power, as the Q of TOF and TP), and FALSE while the left rail is OFF (OFF MC zone), so a later coil writes FALSE there. inst is written twice (the call and inst.out_pin); it is a name, so it is not evaluated twice. *)
(* FB_EXEC / FUN_EXEC / FUN_EXEC_RET: called only when powered; the power after the box is ON when the call was executed. Without power the outputs and dst are held. *)
(* FB_ENO / FUN_ENO / FUN_ENO_RET: called only when powered; the power after the box is ENO (received in RungiecTmp). Arguments are named only. *)
(* FBT_SCAN / FBT_IN / FBT_EXEC / FBT_ENO / FBT_BOX: FB_SCAN / FB_IN / FB_EXEC / FB_ENO / FB_BOX with the type of the function block as the second argument. The ST mode does not use or check the type; the LD mode writes it as the typeName of the box. *)
(* Inline ST. ST_EXEC(statements): the ST statements run only when powered (not in an OFF MC zone); the power after the element equals the power before it. To pass a result on, assign it to a variable and read it with a contact: ST_EXEC(Ok := Pos > Lim;), CONTACT(Ok). *)
(* The statements are joined with the comma-protecting built-in, so a bare comma (case labels 1, 2:) is part of the statements and does not split the arguments of RUNG, SERIES, PARALLEL, WIRE or BEGIN_MC (tested in t099). The ';' after the last statement may be written or left out (an empty statement is valid ST). *)
(* Do not write DSL macros, return, directives, comments or Rungiec names in the statements. *)
(* RETURN(): returns from the POU when powered. Write it as the last child of a top-level RUNG or WIRE; a WIRE with RETURN() or JMP() is the last WIRE before END_NET() (checked by the next WIRE, see WIRE). *)
(* Jumps for the target, chosen by the target macros that jiecc predefines. _RUNGIEC_JUMP_KW is the jump keyword of the expanded ST: jmp when _CODESYS is TRUE (jiecc -t codesys), goto otherwise and when jiepp runs alone (the target macros are not defined). _RUNGIEC_JUMP_OK is 0 when _OMRON, _KEYENCE or _MITSUBISHI is TRUE (jiecc -t omron, -t keyence, -t mitsubishi): JMP and LABEL are then a preprocessing error, because the jumps of the expanded ST are not known to load into the ST of those tools. Add a target here to give it another keyword. *)
(* JMP(label): jumps to LABEL(label) of the same POU when powered. Write it as the last child of a top-level RUNG or WIRE; a WIRE with JMP() or RETURN() is the last WIRE before END_NET() (checked by the next WIRE, see WIRE). Before the jump it restores the state between networks, so the statement macro after the label does not fault. *)
(* Checks: a JMP back to a LABEL needs the same MC segment (no BEGIN_MC or END_MC between them); all forward JMPs to one label are in one segment, and LABEL checks that it is the segment of the label. A label that is never defined is the jiecc error UNDEFINED_SYMBOL. *)
(* The counter names are pasted from the label, so they are case-sensitive while ST labels are not: JMP(Skip) with LABEL(SKIP) passes these checks (lint LN22 reports it). *)
(* Statement macros: RUNG, BEGIN_MC, END_MC, LABEL, BEGIN_NET, WIRE and END_NET end their own statement with ';' (do not write one). *)
(* RUNG, WIRE, BEGIN_MC, END_MC, LABEL and END_NET have RungiecStIn[1 - RungiecSp] := RungiecIn (LABEL right after the label): index 1 at the top level, 0 or below when the macro was nested inside an element, so a nested one faults at run time. A BEGIN_NET written as a child of RUNG, WIRE or BEGIN_MC is a preprocessing error (the network check of the outer macro or of BEGIN_NET itself). *)
(* Between networks (after RUNG, END_NET, BEGIN_MC, END_MC and LABEL, and after a JMP that jumped): RungiecSp = 0, RungiecAcc = TRUE, RungiecEn = RungiecIn = RungiecRail. *)
(* BEGIN_MC(conditions...): from here to the matching END_MC() the left rail is the series of the conditions under the current rail. Zones nest up to RUNGIEC_MC_MAX; END_MC() closes the innermost one. *)
(* LABEL(label): the target of JMP(label), written on its own between networks (or last before END_RUNGIEC()). The statement after the label lets it end a POU. Checks: the target allows jumps (_RUNGIEC_JUMP_OK), not inside BEGIN_NET and END_NET, defined once in the POU, and every earlier JMP(label) of the POU is in the same MC segment. *)
(* General networks. Node 0 is the left rail. WIRE(from, to, elements...) evaluates the elements in series from node from and ORs the result into node to. Node numbers are integer literals from 0 to 64 and not above RUNGIEC_NODE_MAX. *)
(* Rules: from < to; to is not less than the to node of the previous WIRE; numbers may be skipped; a node that no WIRE writes reads FALSE. That each number is an integer literal (node table), the range and the first two rules are checked at preprocessing time. *)
(* So every WIRE that writes a node comes before every WIRE that reads it. BEGIN_NET() sets node 0 to the rail and nodes 1 and up to FALSE on every scan, so no value leaks from an earlier network or scan. *)
(* A WIRE with JMP() or RETURN() is the last WIRE before END_NET(): a jump or return leaves at once, so a later WIRE of the network would not run on that scan. Each JMP() and RETURN() inside a network adds 2 to rungiec_exit while the arguments of its WIRE are expanded (before the checks of that WIRE); every WIRE checks that rungiec_exit is even (no earlier WIRE of the network has one) and then sets it to 1 if it is above 0. *)
program __main__
var
    A, Y: bool;
end_var
var RungiecEn: bool := true; RungiecIn: bool := true; RungiecAcc: bool := true; RungiecVal: bool := true; RungiecTmp: bool; RungiecRail: bool := true; RungiecSp: dint := -1; RungiecStIn: array[1..16] of bool; RungiecStAcc: array[1..16] of bool; RungiecNode: array[0..16] of bool; RungiecI: dint; RungiecMcSt: array[1..15] of bool; RungiecPrev: array[1..64] of bool; end_var
(*{st}*)
          RungiecEn := true; RungiecIn := true; RungiecAcc := true; RungiecVal := true; RungiecTmp := false; RungiecRail := true; RungiecSp := 0;
(*  |--| A |--( Y )--|   the st directive line above is deliberately written by the user  *)
  RungiecStIn[1 - RungiecSp] := RungiecIn; RungiecEn := RungiecRail; RungiecIn := RungiecRail; RungiecSp := RungiecSp + 1; RungiecStIn[RungiecSp] := RungiecIn; RungiecStAcc[RungiecSp] := RungiecAcc; RungiecIn := RungiecEn; RungiecAcc := RungiecIn; RungiecEn := RungiecAcc;  RungiecTmp := (A); RungiecVal := RungiecEn and RungiecTmp; RungiecAcc := RungiecVal; RungiecEn := RungiecAcc;  Y := RungiecEn; RungiecVal := RungiecEn; RungiecAcc := RungiecVal; RungiecVal := RungiecAcc; RungiecEn := RungiecIn; RungiecIn := RungiecStIn[RungiecSp]; RungiecAcc := RungiecStAcc[RungiecSp]; RungiecSp := RungiecSp - 1;
end_program
