(* @expect pass *)
(* @cycles 4 *)
(* Purpose: PARALLEL is OR, followed by a merge coil. *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t002_parallel_or))
TEST_M(t002_parallel_or)
var
    A, B, Y: bool;
    InA: array[1..4] of bool := [false, true, false, true];
    InB: array[1..4] of bool := [false, false, true, true];
    Cyc: dint;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
T_BEGIN()
A := InA[Cyc]; B := InB[Cyc];
(*  |--+--| A |--+--( Y )--|  *)
(*  |  |         |         |  *)
(*  |  +--| B |--+         |  *)
RUNG(PARALLEL(CONTACT(A), CONTACT(B)), COIL(Y))
EXPECT_TRUE(Y = (A or B), 'y_eq_a_or_b');
T_EXPECT_IDLE(idle_after_net1);
END_RUNGIEC()
END_TEST_M
