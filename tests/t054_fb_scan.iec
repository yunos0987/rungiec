(* @expect pass *)
(* @cycles 8 *)
(* Purpose: FB_SCAN: the instance is called on every scan, whatever the power and whatever the left rail, and the power after the box equals the power before it. In an OFF MC zone (left rail OFF) it is still called: the counter advances, the arguments are evaluated and the outputs follow them. Zero arguments work. *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t054_fb_scan))
function ArgProbe : bool
var_input v: bool; end_var
var_in_out cnt: dint; end_var
cnt := cnt + 1;
ArgProbe := v;
end_function
function_block CntFb
var_input sig: bool; end_var
var_output q: bool; n: dint; end_var
n := n + 1;
q := sig;
end_function_block
function_block ZeroFb
var_output n: dint; end_var
n := n + 1;
end_function_block
TEST_M(t054_fb_scan)
var
    P, X, Y1, Y2, Y3: bool;
    Fb0, Fb1, Fb2: CntFb;
    Z0, Z1: ZeroFb;
    ArgCalls: dint;
    InP: array[1..8] of bool := [false, true, false, true, true, false, true, false];
    InX: array[1..8] of bool := [true, true, false, false, true, false, true, true];
    Cyc: dint;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
T_BEGIN()
P := InP[Cyc]; X := InX[Cyc];
(*  |--| P |--[ Fb0(sig := true) ]--( Y1 )--|   outside any zone: called every scan, power OFF or ON, power passes through  *)
RUNG(CONTACT(P), FB_SCAN(Fb0, sig := true), COIL(Y1))
(*  |--[ Z0 ]--|   zero arguments, no contact: called every scan  *)
RUNG(FB_SCAN(Z0))
(*  |--| X |--(MC)--|   the zone turns ON, OFF, ON, OFF, ON  *)
BEGIN_MC(CONTACT(X))
(*  |--| P |--[ Fb1(sig := ArgProbe(v := P, cnt := ArgCalls)) ]--( Y2 )--|   in the zone: called every scan whatever P and X are  *)
RUNG(CONTACT(P), FB_SCAN(Fb1, sig := ArgProbe(v := P, cnt := ArgCalls)), COIL(Y2))
(*  |--[ Z1 ]--|   zero arguments in the zone  *)
RUNG(FB_SCAN(Z1))
(*  |--(MCR)--|  *)
END_MC()
(*  |--| P |--[ Fb2(sig := true) ]--( Y3 )--|   after END_MC: called every scan  *)
RUNG(CONTACT(P), FB_SCAN(Fb2, sig := true), COIL(Y3))
EXPECT_TRUE(Fb0.n = Cyc, 'called_every_scan_power_off_and_on');
EXPECT_TRUE(Y1 = P, 'power_after_box_follows_contact');
EXPECT_TRUE(Z0.n = Cyc, 'zero_arg_called_every_scan');
EXPECT_TRUE(Fb1.n = Cyc, 'zone_box_called_every_scan');
EXPECT_TRUE(ArgCalls = Cyc, 'zone_box_arguments_evaluated_every_scan');
EXPECT_TRUE(Fb1.q = P, 'zone_box_output_follows_argument');
EXPECT_TRUE(Z1.n = Cyc, 'zone_zero_arg_called_every_scan');
EXPECT_TRUE(Y2 = (X and P), 'zone_power_after_box');
EXPECT_TRUE(Fb2.n = Cyc, 'called_every_scan_after_mcr');
EXPECT_TRUE(Y3 = P, 'power_after_box_after_mcr');
T_EXPECT_IDLE(idle_after_nets);
END_RUNGIEC()
END_TEST_M
