(* @expect pp-error PP91: .RUNGIEC ST_EXEC has no statements *)
(* @cycles 1 *)
(* Purpose: ST_EXEC() with no statements is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--[[ ST: ]]--( Y )--|   the statements are deliberately left out  *)
RUNG(CONTACT(A), ST_EXEC(), COIL(Y))
END_RUNGIEC()
end_program
