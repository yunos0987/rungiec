(* @expect pp-error PP91: .RUNGIEC WIRE to node 4 exceeds 3 *)
(* @cycles 1 *)
(* Purpose: With RUNGIEC_NODE_MAX 3, a WIRE to node 4 is a preprocessing error that names the node and the limit. *)
{#define RUNGIEC_NODE_MAX 3}
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--(1)--| A |--(2)--| A |--(3)--( Y )--(4)   *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A))
WIRE(1, 2, CONTACT(A))
WIRE(2, 3, CONTACT(A))
WIRE(3, 4, COIL(Y))
END_NET()
END_RUNGIEC()
end_program
