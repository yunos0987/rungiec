(* t_stdfb.iec - deterministic stand-ins for the IEC 61131-3 standard timers (TON, TOF, TP) and a retentive
   on-delay timer (TONR), shared by the tests.
   Counters and edges (CTU, CTD, CTUD, R_TRIG, F_TRIG) are not here: the tests use the built-in function blocks
   of jiecc 9.4.0 (tools/jiecc). The timers are stand-ins because jiecc --run has no virtual clock: the
   built-in timers run on wall-clock time, so the result of a test would depend on the speed of the machine.
   These blocks are deterministic instead: one call = one scan = one step of time, T#100ms unless the file that
   includes this one defines the macro T_STDFB_STEP before the include (for example as T#250ms).
   Call them with FB_SCAN or FB_IN (called on every scan) so that time advances on every scan.
   They follow IEC 61131-3 Ed. 4 Table 47 / Figure 17 (TP / TON / TOF) and transcribe the recommended
   implementation of Figure 18 with a fixed step added per call in place of the clock, so the scan where IN changes is
   ET = 0 (as in Figure 17) and ET stops at PT. Differences from the standard:
   - Time advances by one step per call, not by real time, so ET is a multiple of the step, and a PT that is not
     a multiple of the step expires at the next multiple (ET then shows PT, as in Figure 18). The elapsed time
     stops counting at 24 h (T#24h), so every PT up to 24 h expires.
   - TOF starts with Q FALSE when IN is FALSE from the first call (the built-in TOF of jiecc 9.4.0 also does).
   - The names are the standard names. A user declaration takes priority over a built-in function block of
     jiecc, so the tests that include this file use these timers instead of the built-in ones.
   - TONR is not an IEC 61131-3 standard block (jiecc 9.4.0 has no TONR). It has the inputs and outputs of the
     TONR (time accumulator) of Siemens S7-1200 / S7-1500: IN, R, PT, Q, ET. *)
{#pragma once}
{#ifndef T_STDFB_STEP}
{#define T_STDFB_STEP T#100ms}
{#endif}
(* TON (Figure 18 TON_TIME): the scan where IN rises is ET = 0 and each further scan with IN TRUE adds one step; Q = IN and ET >= PT, then ET stays at PT. Step T#100ms, PT = T#300ms: Q on the 4th scan with IN TRUE (ET = 0, 100, 200, 300 ms). *)
function_block TON
var_input IN: bool; PT: time; end_var
var_output Q: bool; ET: time; end_var
var acc: time; last: bool; end_var
if (not IN) or (not last) then
    acc := T#0ms;
elsif acc < T#24h then
    acc := acc + T_STDFB_STEP;
end_if;
ET := acc;
Q := IN and (ET >= PT);
if Q then ET := PT; end_if;
last := IN;
end_function_block
(* TOF (Figure 18 TOF_TIME): Q is TRUE while IN is TRUE; the scan where IN falls is ET = 0 and each further scan with IN FALSE adds one step; Q = IN or ET < PT, and once Q is FALSE ET stays at PT. Step T#100ms, PT = T#200ms: Q is still TRUE on the scan of the fall and the next one (ET = 0, 100 ms), FALSE on the 3rd (ET = 200 ms). acc starts at 24 h so that Q is FALSE when IN is FALSE from the first call (the standard START is 0, so ET is already large). *)
function_block TOF
var_input IN: bool; PT: time; end_var
var_output Q: bool; ET: time; end_var
var acc: time := T#24h; last: bool; end_var
if IN or last then
    acc := T#0ms;
elsif acc < T#24h then
    acc := acc + T_STDFB_STEP;
end_if;
ET := acc;
Q := IN or (ET < PT);
if not Q then ET := PT; end_if;
last := IN;
end_function_block
(* TP (Figure 18 TP_TIME): a rising edge of IN starts a pulse of PT (the edge scan is ET = 0, so Q is TRUE for PT / step scans, the edge scan included); IN is ignored while the pulse runs; after the pulse ET stays at PT while IN is TRUE and is 0 while IN is FALSE. *)
function_block TP
var_input IN: bool; PT: time; end_var
var_output Q: bool; ET: time; end_var
var acc: time; last: bool; end_var
if Q then
    if acc < T#24h then acc := acc + T_STDFB_STEP; end_if;
else
    if IN and (not last) then Q := true; end_if;
    if Q or (not IN) then
        acc := T#0ms;
    elsif acc < T#24h then
        acc := acc + T_STDFB_STEP;
    end_if;
end_if;
ET := acc;
if ET >= PT then
    ET := PT;
    Q := false;
end_if;
last := IN;
end_function_block
(* TONR (retentive on-delay, like TON but ET is kept while IN is FALSE): the scan where IN rises adds nothing and each further scan with IN TRUE adds one step, so the time of several runs of IN adds up; IN FALSE keeps ET; Q = ET >= PT, so Q stays TRUE after IN falls; ET stops at PT. R TRUE has priority: ET = 0 and Q = FALSE, and the first scan after R counts as a rise of IN. Step T#100ms, PT = T#300ms: Q on the 4th scan of one run of IN, or after 3 + 2 scans of two runs. *)
function_block TONR
var_input IN: bool; R: bool; PT: time; end_var
var_output Q: bool; ET: time; end_var
var acc: time; last: bool; end_var
if R then
    acc := T#0ms;
elsif IN and last and (acc < T#24h) then
    acc := acc + T_STDFB_STEP;
end_if;
ET := acc;
Q := (not R) and (ET >= PT);
if Q then ET := PT; end_if;
last := IN and (not R);
end_function_block
