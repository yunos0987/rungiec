(* @expect pp-error PP91: .RUNGIEC BEGIN_MC inside BEGIN_NET *)
(* @cycles 1 *)
(* Purpose: BEGIN_MC between BEGIN_NET() and END_NET() is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--(1)--( Y )--|   an MC zone is deliberately opened inside the network  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A))
BEGIN_MC(CONTACT(A))
END_MC()
WIRE(1, 2, COIL(Y))
END_NET()
END_RUNGIEC()
end_program
