(* @expect pp-error PP91: .RUNGIEC END_MC inside BEGIN_NET *)
(* @cycles 1 *)
(* Purpose: END_MC() between BEGIN_NET() and END_NET() is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--(MC)--|  *)
BEGIN_MC(CONTACT(A))
(*  |--| A |--(1)--( Y )--|   the MC zone is deliberately closed inside the network  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A))
END_MC()
WIRE(1, 2, COIL(Y))
END_NET()
END_RUNGIEC()
end_program
