(* @expect pass *)
(* @cycles 8 *)
(* Purpose: With RUNGIEC_VAR() the work variables are static. At the end of every scan the program corrupts all of them, also the five that the init statements of BEGIN_RUNGIEC() do not set: RungiecStIn and RungiecStAcc (FALSE), RungiecNode (TRUE, every node), RungiecI (1000) and RungiecMcSt (FALSE). A nested RUNG with an edge contact, a network inside two MC zones and the rungs after the zones still give the expected outputs on every scan, because each of the five is written before it is read (PUSH before POP, BEGIN_NET before WIRE, BEGIN_MC before END_MC). *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t107_work_vars_dirtied_all))
TEST_M(t107_work_vars_dirtied_all)
var
    A, B, C, D, M1, M2, Y1, Y2, Y3, Y4: bool;
    K, Cyc: dint;
    InA: array[1..8] of bool := [true, false, false, true, true, false, true, false];
    InB: array[1..8] of bool := [false, false, true, false, true, false, false, true];
    InC: array[1..8] of bool := [true, true, true, false, true, true, false, true];
    InD: array[1..8] of bool := [false, false, false, false, false, true, false, false];
    InM1: array[1..8] of bool := [true, true, true, true, false, true, true, true];
    InM2: array[1..8] of bool := [true, true, false, true, true, true, false, true];
    ExpY1: array[1..8] of bool := [true, false, false, false, true, true, false, false];
    ExpY2: array[1..8] of bool := [true, false, false, false, false, false, false, true];
    ExpY3: array[1..8] of bool := [true, false, false, true, false, false, true, false];
    ExpY4: array[1..8] of bool := [false, false, true, false, true, false, false, true];
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
T_BEGIN()
T_EXPECT_IDLE(idle_right_after_begin_rungiec);
A := InA[Cyc]; B := InB[Cyc]; C := InC[Cyc]; D := InD[Cyc]; M1 := InM1[Cyc]; M2 := InM2[Cyc];
(*  |--+--| A |--+--| B |---+--+--( Y1 )--|  *)
(*  |  |         |          |  |          |  *)
(*  |  |         +--|P C |--+  |          |  *)
(*  |  |                       |          |  *)
(*  |  +--| D |----------------+          |  *)
RUNG(PARALLEL(SERIES(CONTACT(A), PARALLEL(CONTACT(B), RISE_CONTACT(C))), CONTACT(D)), COIL(Y1))
EXPECT_TRUE(Y1 = ExpY1[Cyc], 'y1_nested_with_edge');
T_EXPECT_IDLE(idle_after_nested_rung);
(*  |--| M1 |--(MC)--|   depth 1  *)
BEGIN_MC(CONTACT(M1))
(*  |--| M2 |--(MC)--|   depth 2  *)
BEGIN_MC(CONTACT(M2))
(*  |--| A |--(1)--| C |--(2)--( Y2 )--|  *)
(*  |--| B |----------------(2)          *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A))
WIRE(0, 2, CONTACT(B))
WIRE(1, 2, CONTACT(C))
WIRE(2, 3, COIL(Y2))
END_NET()
(*  |--(MCR)--|   closes depth 2  *)
END_MC()
(*  |--| A |--( Y3 )--|   in depth 1  *)
RUNG(CONTACT(A), COIL(Y3))
(*  |--(MCR)--|   closes depth 1  *)
END_MC()
(*  |--| B |--( Y4 )--|   outside the zones  *)
RUNG(CONTACT(B), COIL(Y4))
EXPECT_TRUE(Y2 = ExpY2[Cyc], 'y2_net_in_depth_2_from_cleared_nodes');
EXPECT_TRUE(Y3 = ExpY3[Cyc], 'y3_depth_1_rail_restored_by_end_mc');
EXPECT_TRUE(Y4 = ExpY4[Cyc], 'y4_rail_on_after_end_mc');
T_EXPECT_IDLE(idle_after_zones);
for K := 1 to RUNGIEC_NEST_MAX do RungiecStIn[K] := false; RungiecStAcc[K] := false; end_for;
for K := 0 to RUNGIEC_NODE_MAX do RungiecNode[K] := true; end_for;
for K := 1 to RUNGIEC_MC_MAX do RungiecMcSt[K] := false; end_for;
RungiecI := 1000;
RungiecEn := false; RungiecIn := false; RungiecAcc := false; RungiecVal := false; RungiecRail := false; RungiecTmp := true; RungiecSp := 5;
END_RUNGIEC()
END_TEST_M
