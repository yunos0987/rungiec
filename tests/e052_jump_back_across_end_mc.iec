(* @expect pp-error PP91: .RUNGIEC JMP to Again goes back across BEGIN_MC or END_MC *)
(* @cycles 1 *)
(* Purpose: A backward JMP() from after an END_MC() to a label inside the MC zone would run the zone without its condition, so JMP() stops it with PP91. *)
{#include 'rungiec.iec'}
program __main__
var
    A, B, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--(MC)--|  *)
BEGIN_MC(CONTACT(A))
(*  Again:  *)
LABEL(Again)
(*  |--( Y )--|  *)
RUNG(COIL(Y))
(*  |--(MCR)--|  *)
END_MC()
(*  |--| B |-->>Again  *)
RUNG(CONTACT(B), JMP(Again))
END_RUNGIEC()
end_program
