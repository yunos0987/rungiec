(* @expect pass *)
(* @cycles 6 *)
(* Purpose: the exception to "the power-gated boxes are not called while the left rail is OFF" (FB_SCAN and FB_IN are called on every scan): a function call written in a contact operand (CONTACT, NOT_CONTACT, a comparison contact, a branch of a PARALLEL) is still evaluated on every scan in an OFF MC zone, while the power-gated boxes in the same zone are not called. The coils stay OFF. *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t058_operand_eval_rail_off))
function Probe : bool
var_input v: bool; end_var
var_in_out cnt: dint; end_var
cnt := cnt + 1;
Probe := v;
end_function
function Calc : dint
var_input v: dint; end_var
var_in_out cnt: dint; end_var
cnt := cnt + 1;
Calc := v;
end_function
function_block ZeroFb
var_output n: dint; end_var
n := n + 1;
end_function_block
TEST_M(t058_operand_eval_rail_off)
var
    X, Y1, Y2, Y3, Y4, Y5, After: bool;
    N1, N2, N3, N4a, N4b: dint;
    Box: ZeroFb;
    InX: array[1..6] of bool := [false, true, false, true, true, false];
    ExpBox: array[1..6] of dint := [0, 1, 1, 2, 3, 3];
    Cyc: dint;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
T_BEGIN()
X := InX[Cyc];
(*  |--| X |--(MC)--|   the zone is OFF in scans 1, 3 and 6  *)
BEGIN_MC(CONTACT(X))
(*  |--| Probe(v := true, cnt := N1) |--( Y1 )--|  *)
RUNG(CONTACT(Probe(v := true, cnt := N1)), COIL(Y1))
(*  |--|/Probe(v := false, cnt := N2) |--( Y2 )--|  *)
RUNG(NOT_CONTACT(Probe(v := false, cnt := N2)), COIL(Y2))
(*  |--| Calc(v := 5, cnt := N3) > 3 |--( Y3 )--|  *)
RUNG(GT_CONTACT(Calc(v := 5, cnt := N3), 3), COIL(Y3))
(*  |--+--| Probe(v := true, cnt := N4a) |--+--( Y4 )--|  *)
(*  |  |                                    |          |  *)
(*  |  +--|/Probe(v := true, cnt := N4b) |--+          |  *)
RUNG(PARALLEL(CONTACT(Probe(v := true, cnt := N4a)), NOT_CONTACT(Probe(v := true, cnt := N4b))), COIL(Y4))
(*  |--[ Box ]--( Y5 )--|   a box in the same zone is not called while the zone is OFF  *)
RUNG(FB_EXEC(Box), COIL(Y5))
(*  |--(MCR)--|  *)
END_MC()
(*  |--( After )--|  *)
RUNG(COIL(After))
EXPECT_TRUE(N1 = Cyc, 'contact_operand_evaluated_every_scan');
EXPECT_TRUE(N2 = Cyc, 'not_contact_operand_evaluated_every_scan');
EXPECT_TRUE(N3 = Cyc, 'comparison_operand_evaluated_every_scan');
EXPECT_TRUE((N4a = Cyc) and (N4b = Cyc), 'parallel_branch_operands_evaluated_every_scan');
EXPECT_TRUE((Y1 = X) and (Y2 = X) and (Y3 = X) and (Y4 = X), 'coils_follow_rail_and_contact');
EXPECT_TRUE((Box.n = ExpBox[Cyc]) and (Y5 = X), 'box_in_same_zone_called_only_while_rail_on');
EXPECT_TRUE(After, 'rail_on_after_mcr');
T_EXPECT_IDLE(idle_after_mcr);
END_RUNGIEC()
END_TEST_M
