(* @expect pass *)
(* @cycles 14 *)
(* Check for examples/on_delay_timer.iec: feeds inputs and verifies the ladder. *)
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(x_on_delay_timer))
(* The TON of t_stdfb.iec with a step of 250 ms per call: the scan where Start rises is ET = 0, so PT = T#1s elapses on the 5th scan with Start = TRUE (ET = 0, 250, 500, 750, 1000 ms). *)
{#define T_STDFB_STEP T#250ms}
{#include 't_stdfb.iec'}
{#include 'on_delay_timer.iec'}
TEST_M(x_on_delay_timer)
var
    Ctl: on_delay_timer;
    Start: bool;
    InStart: array[1..14] of bool := [false, true, true, true, true, true, true, false, true, true, true, true, true, true];
    ExpLamp: array[1..14] of bool := [false, false, false, false, false, true, true, false, false, false, false, false, true, true];
    Cyc: dint;
end_var
T_BEGIN()
Start := InStart[Cyc];
Ctl(Start := Start);
EXPECT_TRUE(Ctl.Lamp = ExpLamp[Cyc], 'lamp_follows_expected_sequence');
EXPECT_TRUE((Cyc <> 5) or (not Ctl.Lamp), 'lamp_still_off_on_fourth_scan');
EXPECT_TRUE((Cyc <> 6) or Ctl.Lamp, 'lamp_on_on_fifth_scan');
EXPECT_TRUE((Cyc <> 8) or (not Ctl.Lamp), 'lamp_off_when_start_released');
EXPECT_TRUE((Cyc <> 12) or (not Ctl.Lamp), 'delay_restarts_after_release');
EXPECT_TRUE((Cyc <> 13) or Ctl.Lamp, 'lamp_on_again_on_fifth_scan');
END_TEST_M
