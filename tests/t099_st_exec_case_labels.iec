(* @expect pass *)
(* @cycles 6 *)
(* Purpose: bare commas in the statements of ST_EXEC (case label lists 1, 2 and 3..4, 6) do not split the arguments of the macro around it: ST_EXEC as the first, middle and last child of RUNG (with edge contacts before and after it), inside SERIES inside PARALLEL, directly in PARALLEL, in WIRE and in the BEGIN_MC conditions. The commas inside an array literal and an index are shown too. The reference values are computed in plain ST. *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t099_st_exec_case_labels))
TEST_M(t099_st_exec_case_labels)
var
    X, PX, Y1, Y2, Y3, Y4, Y5, Ry: bool;
    N, K1, K2, K3, K4, K5, K6, K7, E: dint;
    Arr: array[1..3] of dint;
    InX: array[1..6] of bool := [false, true, true, false, true, true];
    Cyc: dint;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
T_BEGIN()
X := InX[Cyc];
N := Cyc;
K1 := 0; K2 := 0; K3 := 0; K4 := 0; K5 := 0; K6 := 0; K7 := 0;
(*  |--[[ ST: case N of 1, 2: K1 := 1; 3..4, 6: K1 := 2; end_case; ]]--| X |--( Y1 )--|   first child  *)
RUNG(ST_EXEC(case N of 1, 2: K1 := 1; 3..4, 6: K1 := 2; end_case;), CONTACT(X), COIL(Y1))
(*  |--|P X |--[[ ST: case N of 1, 2, 3..4: K2 := 1; else K2 := 9; end_case; ]]--|P X |--( Y2 )--|   middle child between edge contacts  *)
RUNG(RISE_CONTACT(X), ST_EXEC(case N of 1, 2, 3..4: K2 := 1; else K2 := 9; end_case;), RISE_CONTACT(X), COIL(Y2))
(*  |--| X |--[[ ST: Arr := [1, 2, 3]; K3 := Arr[2]; ]]--|   last child  *)
RUNG(CONTACT(X), ST_EXEC(Arr := [1, 2, 3]; K3 := Arr[2];))
(*  |--+--| X |--[[ ST: case N of 2, 3: K4 := 1; end_case; ]]--+--( Y3 )--|  *)
(*  |  |                                                       |          |  *)
(*  |  +--[[ ST: case N of 5, 6: K5 := 1; end_case; ]]---------+          |  *)
RUNG(PARALLEL(SERIES(CONTACT(X), ST_EXEC(case N of 2, 3: K4 := 1; end_case;)), ST_EXEC(case N of 5, 6: K5 := 1; end_case;)), COIL(Y3))
(*  |--| X |--[[ ST: case N of 1, 2, 5..6: K6 := 1; end_case; ]]--(1)--( Y4 )--|  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(X), ST_EXEC(case N of 1, 2, 5..6: K6 := 1; end_case;))
WIRE(1, 2, COIL(Y4))
END_NET()
(*  |--| X |--[[ ST: case N of 2, 3: K7 := 1; end_case; ]]--(MC)--|  *)
BEGIN_MC(CONTACT(X), ST_EXEC(case N of 2, 3: K7 := 1; end_case;))
(*  |--( Y5 )--|  *)
RUNG(COIL(Y5))
(*  |--(MCR)--|  *)
END_MC()
(* reference values in plain ST *)
E := 0; case N of 1, 2: E := 1; 3..4, 6: E := 2; end_case;
EXPECT_TRUE(K1 = E, 'k1_first_child');
EXPECT_TRUE(Y1 = X, 'y1_first_child');
Ry := X and not PX;
E := 0; if Ry then case N of 1, 2, 3..4: E := 1; else E := 9; end_case; end_if;
EXPECT_TRUE(K2 = E, 'k2_middle_child');
EXPECT_TRUE(Y2 = Ry, 'y2_middle_child');
E := 0; if X then E := 2; end_if;
EXPECT_TRUE(K3 = E, 'k3_last_child');
E := 0; if X and ((N = 2) or (N = 3)) then E := 1; end_if;
EXPECT_TRUE(K4 = E, 'k4_series_in_parallel');
E := 0; if (N = 5) or (N = 6) then E := 1; end_if;
EXPECT_TRUE(K5 = E, 'k5_in_parallel');
EXPECT_TRUE(Y3, 'y3_parallel_branch_with_st_is_on');
E := 0; if X and ((N <= 2) or (N >= 5)) then E := 1; end_if;
EXPECT_TRUE(K6 = E, 'k6_in_wire');
EXPECT_TRUE(Y4 = X, 'y4_in_wire');
E := 0; if X and ((N = 2) or (N = 3)) then E := 1; end_if;
EXPECT_TRUE(K7 = E, 'k7_in_begin_mc');
EXPECT_TRUE(Y5 = X, 'y5_in_begin_mc');
PX := X;
T_EXPECT_IDLE(idle_after_nets);
END_RUNGIEC()
END_TEST_M
