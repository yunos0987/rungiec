(* @expect pp-error PP91: .RUNGIEC RUNG has 17 elements, allowed 1 to 16 *)
(* @cycles 1 *)
(* Purpose: RUNG with 17 terms is above the default limit 16 and is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |-- ... --| A |--|   17 contacts  *)
RUNG(CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A))
END_RUNGIEC()
end_program
