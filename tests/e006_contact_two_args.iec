(* @expect pp-error PP34.*CONTACT: expected 1, got 2 *)
(* @cycles 1 *)
(* Purpose: CONTACT with two arguments is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--( Y )--|  *)
RUNG(CONTACT(A, Y), COIL(Y))
END_RUNGIEC()
end_program
