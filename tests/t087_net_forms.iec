(* @expect pass *)
(* @cycles 8 *)
(* Purpose: forms of BEGIN_NET / WIRE / END_NET: several elements in one WIRE, a PARALLEL inside a WIRE, two WIREs merging into one node, two terminal coils, a coil in the middle of a WIRE passing its power through, an edge contact inside a WIRE, a second network that reuses node numbers, a network inside an MC zone (node 0 = the zone rail), and networks mixed with RUNG. The state after the networks is idle. *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t087_net_forms))
TEST_M(t087_net_forms)
var
    A, B, C, D, K, Z, PrevC: bool;
    M1, M2, N1, P1, R1, Q1, Zn: bool;
    InA: array[1..8] of bool := [true, true, false, true, true, true, false, true];
    InB: array[1..8] of bool := [true, true, false, false, true, true, true, true];
    InC: array[1..8] of bool := [false, true, true, false, false, true, true, false];
    InD: array[1..8] of bool := [false, false, true, false, true, false, true, false];
    InK: array[1..8] of bool := [false, true, false, true, false, false, true, false];
    InZ: array[1..8] of bool := [true, true, false, true, false, true, true, false];
    Cyc: dint;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
T_BEGIN()
A := InA[Cyc]; B := InB[Cyc]; C := InC[Cyc]; D := InD[Cyc]; K := InK[Cyc]; Z := InZ[Cyc];
(*  |--| A |--| B |--+--(1)--+--| D |--+--(2)--( M2 )--|  *)
(*  |                |       |         |                 *)
(*  |--| C |---------+       +--| K |--+                 *)
(*  |                        |                           *)
(*  |                        +--( M1 )-------------------|  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A), CONTACT(B))
WIRE(0, 1, CONTACT(C))
WIRE(1, 2, PARALLEL(CONTACT(D), CONTACT(K)))
WIRE(1, 3, COIL(M1))
WIRE(2, 4, COIL(M2))
END_NET()
(*  |--| K |--( Q1 )--|   a RUNG between networks  *)
RUNG(CONTACT(K), COIL(Q1))
(*  |--| D |--(1)--( N1 )--|   node numbers reused in a second network  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(D))
WIRE(1, 2, COIL(N1))
END_NET()
(*  |--| A |--( P1 )--| B |--(1)--|P C |--( R1 )--|   a coil in the middle passes its power through  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A), COIL(P1), CONTACT(B))
WIRE(1, 2, RISE_CONTACT(C), COIL(R1))
END_NET()
(*  |--| Z |--(MC)--|  *)
BEGIN_MC(CONTACT(Z))
(*  |--| A |--(1)--( Zn )--|   node 0 is the zone rail  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A))
WIRE(1, 2, COIL(Zn))
END_NET()
(*  |--(MCR)--|  *)
END_MC()
EXPECT_TRUE(M1 = ((A and B) or C), 'multi_element_wire_and_merge');
EXPECT_TRUE(M2 = (((A and B) or C) and (D or K)), 'parallel_inside_wire');
EXPECT_TRUE(Q1 = K, 'rung_between_networks');
EXPECT_TRUE(N1 = D, 'second_network');
EXPECT_TRUE(P1 = A, 'coil_in_middle_of_wire');
EXPECT_TRUE(R1 = (A and B and C and not PrevC), 'edge_contact_inside_wire');
EXPECT_TRUE(Zn = (Z and A), 'network_inside_mc_zone');
T_EXPECT_IDLE(idle_after_nets);
PrevC := C;
END_RUNGIEC()
END_TEST_M
