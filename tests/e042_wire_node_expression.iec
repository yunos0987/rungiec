(* @expect pp-error PP91: .RUNGIEC WIRE to node 1 . 1 is not an integer literal from 0 to 64 *)
(* @cycles 1 *)
(* Purpose: A WIRE node number must be an integer literal: an expression of integer literals is rejected even though its value is in range. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--(1)--( Y )--(2)--|   the to node of the second WIRE is written as 1 + 1  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A))
WIRE(1, 1 + 1, COIL(Y))
END_NET()
END_RUNGIEC()
end_program
