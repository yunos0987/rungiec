(* @expect pp-error PP91: .RUNGIEC END_NET is missing before END_RUNGIEC *)
(* @cycles 1 *)
(* Purpose: A network left open at END_RUNGIEC() is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--( Y )--|   END_NET() is deliberately omitted  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A), COIL(Y))
END_RUNGIEC()
end_program
