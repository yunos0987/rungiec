(* @expect pp-error PP91: .RUNGIEC BEGIN_NET inside BEGIN_NET *)
(* @cycles 1 *)
(* Purpose: BEGIN_NET() inside an open network is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |--(1)--|   the first network is not closed  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(A))
(*  |--( Y )--|  *)
BEGIN_NET()
WIRE(0, 1, COIL(Y))
END_NET()
END_RUNGIEC()
end_program
