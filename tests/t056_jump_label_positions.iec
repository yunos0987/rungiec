(* @expect pass *)
(* @cycles 4 *)
(* Purpose: LABEL() works before the first network, right after another label, END_NET(), a rung, BEGIN_MC() and END_MC(). A backward JMP() to the first label, a forward JMP() to the second of two labels in a row, a JMP() from a WIRE over the rung after END_NET(), and a backward JMP() inside an MC zone that runs the zone 3 times per scan while the zone is ON. *)
{#include 'rungiec.iec'}
{#include 't_jiecunit.iec'}
DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(t056_jump_label_positions))
TEST_M(t056_jump_label_positions)
var
    J, K, M, N1: bool;
    Count, Loops, Net, Laps, Total: dint;
    Cyc: dint;
    InJ: array[1..4] of bool := [false, true, false, true];
    InK: array[1..4] of bool := [false, true, true, false];
    InM: array[1..4] of bool := [true, true, false, false];
    ExpNet: array[1..4] of dint := [1, 1, 1, 2];
    ExpLaps: array[1..4] of dint := [3, 3, 0, 0];
    ExpTotal: array[1..4] of dint := [3, 6, 6, 6];
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
T_BEGIN()
J := InJ[Cyc]; K := InK[Cyc]; M := InM[Cyc];
(*  Top:  *)
LABEL(Top)
(*  |--[[ ST: Loops := Loops + 1; ]]--|  *)
RUNG(ST_EXEC(Loops := Loops + 1;))
(*  |--| Loops < 2 |-->>Top  *)
RUNG(LT_CONTACT(Loops, 2), JMP(Top))
EXPECT_TRUE(Loops = Cyc + 1, 'label_before_first_network');
(*  |--| J |-->>Second  *)
RUNG(CONTACT(J), JMP(Second))
(*  |--[[ ST: Count := Count + 1; ]]--|  *)
RUNG(ST_EXEC(Count := Count + 1;))
(*  First:  *)
LABEL(First)
(*  Second:  *)
LABEL(Second)
(*  |--| K |-->>AfterNet   leaves the network  *)
BEGIN_NET()
WIRE(0, 1, CONTACT(K), JMP(AfterNet))
END_NET()
(*  NetEnd:  *)
LABEL(NetEnd)
(*  |--[[ ST: Net := Net + 1; ]]--|   skipped when the WIRE jumps  *)
RUNG(ST_EXEC(Net := Net + 1;))
(*  AfterNet:  *)
LABEL(AfterNet)
(*  |--[[ ST: Laps := 0; ]]--|  *)
RUNG(ST_EXEC(Laps := 0;))
(*  |--| M |--(MC)--|  *)
BEGIN_MC(CONTACT(M))
(*  InZone:  *)
LABEL(InZone)
(*  |--| J |--( N1 )--|  *)
RUNG(CONTACT(J), COIL(N1))
(*  |--[[ ST: Laps := Laps + 1; Total := Total + 1; ]]--|  *)
RUNG(ST_EXEC(Laps := Laps + 1; Total := Total + 1;))
(*  |--| Laps < 3 |-->>InZone   back into the zone, not taken while the zone is OFF  *)
RUNG(LT_CONTACT(Laps, 3), JMP(InZone))
(*  |--(MCR)--|  *)
END_MC()
(*  AfterZone:  *)
LABEL(AfterZone)
EXPECT_TRUE(N1 = (M and J), 'label_after_begin_mc');
EXPECT_TRUE(Count = 1 + (Cyc - 1) / 2, 'count_skipped_when_j');
EXPECT_TRUE(Net = ExpNet[Cyc], 'net_rung_skipped_when_wire_jumps');
EXPECT_TRUE(Laps = ExpLaps[Cyc], 'zone_runs_three_times_when_on');
EXPECT_TRUE(Total = ExpTotal[Cyc], 'zone_total_laps');
T_EXPECT_IDLE(idle_after_net);
END_RUNGIEC()
END_TEST_M
