(* @expect pp-error PP91: .RUNGIEC SERIES has 17 elements, allowed 1 to 16 *)
(* @cycles 1 *)
(* Purpose: SERIES with 17 terms inside a RUNG is above the default limit 16 and is a preprocessing error. *)
{#include 'rungiec.iec'}
program __main__
var
    A, Y: bool;
end_var
RUNGIEC_VAR()
BEGIN_RUNGIEC()
(*  |--| A |-- ... --| A |--( Y )--|   17-term SERIES  *)
RUNG(SERIES(CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A), CONTACT(A)), COIL(Y))
END_RUNGIEC()
end_program
