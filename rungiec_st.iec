{#define _RUNGIEC_SERIES_30(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30) _RUNGIEC_PUSH() RungiecAcc := RungiecIn; _RUNGIEC_S(c1) _RUNGIEC_S(c2) _RUNGIEC_S(c3) _RUNGIEC_S(c4) _RUNGIEC_S(c5) _RUNGIEC_S(c6) _RUNGIEC_S(c7) _RUNGIEC_S(c8) _RUNGIEC_S(c9) _RUNGIEC_S(c10) _RUNGIEC_S(c11) _RUNGIEC_S(c12) _RUNGIEC_S(c13) _RUNGIEC_S(c14) _RUNGIEC_S(c15) _RUNGIEC_S(c16) _RUNGIEC_S(c17) _RUNGIEC_S(c18) _RUNGIEC_S(c19) _RUNGIEC_S(c20) _RUNGIEC_S(c21) _RUNGIEC_S(c22) _RUNGIEC_S(c23) _RUNGIEC_S(c24) _RUNGIEC_S(c25) _RUNGIEC_S(c26) _RUNGIEC_S(c27) _RUNGIEC_S(c28) _RUNGIEC_S(c29) _RUNGIEC_S(c30) _RUNGIEC_POP()}
{#define _RUNGIEC_PARALLEL_30(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30) _RUNGIEC_PUSH() RungiecAcc := false; _RUNGIEC_P(c1) _RUNGIEC_P(c2) _RUNGIEC_P(c3) _RUNGIEC_P(c4) _RUNGIEC_P(c5) _RUNGIEC_P(c6) _RUNGIEC_P(c7) _RUNGIEC_P(c8) _RUNGIEC_P(c9) _RUNGIEC_P(c10) _RUNGIEC_P(c11) _RUNGIEC_P(c12) _RUNGIEC_P(c13) _RUNGIEC_P(c14) _RUNGIEC_P(c15) _RUNGIEC_P(c16) _RUNGIEC_P(c17) _RUNGIEC_P(c18) _RUNGIEC_P(c19) _RUNGIEC_P(c20) _RUNGIEC_P(c21) _RUNGIEC_P(c22) _RUNGIEC_P(c23) _RUNGIEC_P(c24) _RUNGIEC_P(c25) _RUNGIEC_P(c26) _RUNGIEC_P(c27) _RUNGIEC_P(c28) _RUNGIEC_P(c29) _RUNGIEC_P(c30) _RUNGIEC_POP()}
{#define _RUNGIEC_SERIES_31(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31) _RUNGIEC_PUSH() RungiecAcc := RungiecIn; _RUNGIEC_S(c1) _RUNGIEC_S(c2) _RUNGIEC_S(c3) _RUNGIEC_S(c4) _RUNGIEC_S(c5) _RUNGIEC_S(c6) _RUNGIEC_S(c7) _RUNGIEC_S(c8) _RUNGIEC_S(c9) _RUNGIEC_S(c10) _RUNGIEC_S(c11) _RUNGIEC_S(c12) _RUNGIEC_S(c13) _RUNGIEC_S(c14) _RUNGIEC_S(c15) _RUNGIEC_S(c16) _RUNGIEC_S(c17) _RUNGIEC_S(c18) _RUNGIEC_S(c19) _RUNGIEC_S(c20) _RUNGIEC_S(c21) _RUNGIEC_S(c22) _RUNGIEC_S(c23) _RUNGIEC_S(c24) _RUNGIEC_S(c25) _RUNGIEC_S(c26) _RUNGIEC_S(c27) _RUNGIEC_S(c28) _RUNGIEC_S(c29) _RUNGIEC_S(c30) _RUNGIEC_S(c31) _RUNGIEC_POP()}
{#define _RUNGIEC_PARALLEL_31(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31) _RUNGIEC_PUSH() RungiecAcc := false; _RUNGIEC_P(c1) _RUNGIEC_P(c2) _RUNGIEC_P(c3) _RUNGIEC_P(c4) _RUNGIEC_P(c5) _RUNGIEC_P(c6) _RUNGIEC_P(c7) _RUNGIEC_P(c8) _RUNGIEC_P(c9) _RUNGIEC_P(c10) _RUNGIEC_P(c11) _RUNGIEC_P(c12) _RUNGIEC_P(c13) _RUNGIEC_P(c14) _RUNGIEC_P(c15) _RUNGIEC_P(c16) _RUNGIEC_P(c17) _RUNGIEC_P(c18) _RUNGIEC_P(c19) _RUNGIEC_P(c20) _RUNGIEC_P(c21) _RUNGIEC_P(c22) _RUNGIEC_P(c23) _RUNGIEC_P(c24) _RUNGIEC_P(c25) _RUNGIEC_P(c26) _RUNGIEC_P(c27) _RUNGIEC_P(c28) _RUNGIEC_P(c29) _RUNGIEC_P(c30) _RUNGIEC_P(c31) _RUNGIEC_POP()}
{#define _RUNGIEC_SERIES_32(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32) _RUNGIEC_PUSH() RungiecAcc := RungiecIn; _RUNGIEC_S(c1) _RUNGIEC_S(c2) _RUNGIEC_S(c3) _RUNGIEC_S(c4) _RUNGIEC_S(c5) _RUNGIEC_S(c6) _RUNGIEC_S(c7) _RUNGIEC_S(c8) _RUNGIEC_S(c9) _RUNGIEC_S(c10) _RUNGIEC_S(c11) _RUNGIEC_S(c12) _RUNGIEC_S(c13) _RUNGIEC_S(c14) _RUNGIEC_S(c15) _RUNGIEC_S(c16) _RUNGIEC_S(c17) _RUNGIEC_S(c18) _RUNGIEC_S(c19) _RUNGIEC_S(c20) _RUNGIEC_S(c21) _RUNGIEC_S(c22) _RUNGIEC_S(c23) _RUNGIEC_S(c24) _RUNGIEC_S(c25) _RUNGIEC_S(c26) _RUNGIEC_S(c27) _RUNGIEC_S(c28) _RUNGIEC_S(c29) _RUNGIEC_S(c30) _RUNGIEC_S(c31) _RUNGIEC_S(c32) _RUNGIEC_POP()}
{#define _RUNGIEC_PARALLEL_32(c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32) _RUNGIEC_PUSH() RungiecAcc := false; _RUNGIEC_P(c1) _RUNGIEC_P(c2) _RUNGIEC_P(c3) _RUNGIEC_P(c4) _RUNGIEC_P(c5) _RUNGIEC_P(c6) _RUNGIEC_P(c7) _RUNGIEC_P(c8) _RUNGIEC_P(c9) _RUNGIEC_P(c10) _RUNGIEC_P(c11) _RUNGIEC_P(c12) _RUNGIEC_P(c13) _RUNGIEC_P(c14) _RUNGIEC_P(c15) _RUNGIEC_P(c16) _RUNGIEC_P(c17) _RUNGIEC_P(c18) _RUNGIEC_P(c19) _RUNGIEC_P(c20) _RUNGIEC_P(c21) _RUNGIEC_P(c22) _RUNGIEC_P(c23) _RUNGIEC_P(c24) _RUNGIEC_P(c25) _RUNGIEC_P(c26) _RUNGIEC_P(c27) _RUNGIEC_P(c28) _RUNGIEC_P(c29) _RUNGIEC_P(c30) _RUNGIEC_P(c31) _RUNGIEC_P(c32) _RUNGIEC_POP()}

{#define _RUNGIEC_SERIES_ANY(...) _RUNGIEC_CAT_X(_RUNGIEC_SERIES_, __VA_ARGC__)(__VA_ARGS__)}
{#define SERIES(...) _RUNGIEC_ARITY_CHECK(SERIES, __VA_ARGC__) _RUNGIEC_CAT_X(_RUNGIEC_SERIES_, __VA_ARGC__)(__VA_ARGS__)}
{#define PARALLEL(...) _RUNGIEC_ARITY_CHECK(PARALLEL, __VA_ARGC__) _RUNGIEC_CAT_X(_RUNGIEC_PARALLEL_, __VA_ARGC__)(__VA_ARGS__)}

(* Contacts. The operand is evaluated exactly once, regardless of the power flow. A contact gives its input power and its condition (RungiecEn and ...), so the series copies the value of each child (RungiecAcc := RungiecVal). *)
{#define CONTACT(x) RungiecTmp := (x); RungiecVal := RungiecEn and RungiecTmp}
{#define NOT_CONTACT(x) RungiecTmp := (x); RungiecVal := RungiecEn and not RungiecTmp}

(* Edge contacts and transition-sensing coils. Each call site takes the next slot of RungiecPrev through __counter(rungiec_edge), which BEGIN_RUNGIEC() restarts at 1 in every POU. *)
(* jiepp expands an argument once per call, so n is the same integer literal everywhere in the body. The previous value is updated on every scan, regardless of the power flow. *)
{#define RISE_CONTACT(x) _RUNGIEC_RISE_I(x, __counter(rungiec_edge))}
{#define _RUNGIEC_RISE_I(x, n) _RUNGIEC_EDGE_CHECK(n) RungiecTmp := (x); RungiecVal := RungiecEn and RungiecTmp and not RungiecPrev[n]; RungiecPrev[n] := RungiecTmp}
{#define FALL_CONTACT(x) _RUNGIEC_FALL_I(x, __counter(rungiec_edge))}
{#define _RUNGIEC_FALL_I(x, n) _RUNGIEC_EDGE_CHECK(n) RungiecTmp := (x); RungiecVal := RungiecEn and not RungiecTmp and RungiecPrev[n]; RungiecPrev[n] := RungiecTmp}
{#define NOT_RISE_CONTACT(x) _RUNGIEC_NOT_RISE_I(x, __counter(rungiec_edge))}
{#define _RUNGIEC_NOT_RISE_I(x, n) _RUNGIEC_EDGE_CHECK(n) RungiecTmp := (x); RungiecVal := RungiecEn and not (RungiecTmp and not RungiecPrev[n]); RungiecPrev[n] := RungiecTmp}
{#define NOT_FALL_CONTACT(x) _RUNGIEC_NOT_FALL_I(x, __counter(rungiec_edge))}
{#define _RUNGIEC_NOT_FALL_I(x, n) _RUNGIEC_EDGE_CHECK(n) RungiecTmp := (x); RungiecVal := RungiecEn and not (not RungiecTmp and RungiecPrev[n]); RungiecPrev[n] := RungiecTmp}
{#define RISE_COIL(x) _RUNGIEC_RISE_COIL_I(x, __counter(rungiec_edge))}
{#define _RUNGIEC_RISE_COIL_I(x, n) _RUNGIEC_EDGE_CHECK(n) x := RungiecEn and not RungiecPrev[n]; RungiecPrev[n] := RungiecEn; RungiecVal := RungiecEn}
{#define FALL_COIL(x) _RUNGIEC_FALL_COIL_I(x, __counter(rungiec_edge))}
{#define _RUNGIEC_FALL_COIL_I(x, n) _RUNGIEC_EDGE_CHECK(n) x := not RungiecEn and RungiecPrev[n]; RungiecPrev[n] := RungiecEn; RungiecVal := RungiecEn}

(* Coils. The power after a coil is its own input power (IEC 61131-3 8.2.5 pass-through). NOT_COIL writes FALSE while the left rail is OFF (OFF MC zone). *)
{#define COIL(x) x := RungiecEn; RungiecVal := RungiecEn}
{#define NOT_COIL(x) x := RungiecRail and not RungiecEn; RungiecVal := RungiecEn}
{#define SET_COIL(x) RungiecTmp := RungiecEn; if RungiecTmp then x := true; end_if; RungiecVal := RungiecTmp}
{#define RESET_COIL(x) RungiecTmp := RungiecEn; if RungiecTmp then x := false; end_if; RungiecVal := RungiecTmp}

(* Comparison contacts. Each operand is evaluated exactly once, regardless of the power flow. *)
{#define EQ_CONTACT(a, b) RungiecTmp := ((a) = (b)); RungiecVal := RungiecEn and RungiecTmp}
{#define NE_CONTACT(a, b) RungiecTmp := ((a) <> (b)); RungiecVal := RungiecEn and RungiecTmp}
{#define GT_CONTACT(a, b) RungiecTmp := ((a) > (b)); RungiecVal := RungiecEn and RungiecTmp}
{#define GE_CONTACT(a, b) RungiecTmp := ((a) >= (b)); RungiecVal := RungiecEn and RungiecTmp}
{#define LT_CONTACT(a, b) RungiecTmp := ((a) < (b)); RungiecVal := RungiecEn and RungiecTmp}
{#define LE_CONTACT(a, b) RungiecTmp := ((a) <= (b)); RungiecVal := RungiecEn and RungiecTmp}

(* Function and function block calls. All box macros take call syntax only: an instance or function name, then the call arguments. *)
(* FB_SCAN(inst, args...): called on every scan, whatever the power and whatever the left rail. The power after the box equals the power before it. *)
(* FB_IN(inst, pin, args...): called on every scan with the power connected to the input pin (IN of TON, CU of CTU, CLK of R_TRIG). The power after the box equals the power before it, so read inst.Q with CONTACT; for TOF, TP and counters read it in a separate RUNG. *)
(* FB_BOX(inst, in_pin, out_pin, args...): called on every scan with the power connected to the input pin in_pin; the power after the box is the output inst.out_pin (the box of IEC 61131-3: it replaces the power before the box, also when it is TRUE without power, as the Q of TOF and TP), and FALSE while the left rail is OFF (OFF MC zone), so a later coil writes FALSE there. inst is written twice (the call and inst.out_pin); it is a name, so it is not evaluated twice. *)
(* FB_EXEC / FUN_EXEC / FUN_EXEC_RET: called only when powered; the power after the box is ON when the call was executed. Without power the outputs and dst are held. *)
(* FB_ENO / FUN_ENO / FUN_ENO_RET: called only when powered; the power after the box is ENO (received in RungiecTmp). Arguments are named only. *)
(* FBT_SCAN / FBT_IN / FBT_EXEC / FBT_ENO / FBT_BOX: FB_SCAN / FB_IN / FB_EXEC / FB_ENO / FB_BOX with the type of the function block as the second argument. The ST mode does not use or check the type; the LD mode writes it as the typeName of the box. *)
{#define FB_SCAN(inst, ...) RungiecTmp := RungiecEn; inst(__VA_ARGS__); RungiecVal := RungiecTmp}
{#define FB_IN(inst, pin, ...) RungiecTmp := RungiecEn; inst(pin := RungiecTmp __VA_OPT__(,) __VA_ARGS__); RungiecVal := RungiecTmp}
{#define FB_BOX(inst, in_pin, out_pin, ...) RungiecTmp := RungiecEn; inst(in_pin := RungiecTmp __VA_OPT__(,) __VA_ARGS__); RungiecVal := RungiecRail and inst.out_pin}
{#define FBT_SCAN(inst, type, ...) RungiecTmp := RungiecEn; inst(__VA_ARGS__); RungiecVal := RungiecTmp}
{#define FBT_IN(inst, type, pin, ...) RungiecTmp := RungiecEn; inst(pin := RungiecTmp __VA_OPT__(,) __VA_ARGS__); RungiecVal := RungiecTmp}
{#define FBT_BOX(inst, type, in_pin, out_pin, ...) RungiecTmp := RungiecEn; inst(in_pin := RungiecTmp __VA_OPT__(,) __VA_ARGS__); RungiecVal := RungiecRail and inst.out_pin}
{#define FB_EXEC(inst, ...) RungiecTmp := RungiecEn; if RungiecTmp then inst(__VA_ARGS__); end_if; RungiecVal := RungiecTmp}
{#define FBT_EXEC(inst, type, ...) RungiecTmp := RungiecEn; if RungiecTmp then inst(__VA_ARGS__); end_if; RungiecVal := RungiecTmp}
{#define FUN_EXEC(fn, ...) RungiecTmp := RungiecEn; if RungiecTmp then fn(__VA_ARGS__); end_if; RungiecVal := RungiecTmp}
{#define FUN_EXEC_RET(dst, fn, ...) RungiecTmp := RungiecEn; if RungiecTmp then dst := fn(__VA_ARGS__); end_if; RungiecVal := RungiecTmp}
{#define FB_ENO(inst, ...) RungiecTmp := false; if RungiecEn then inst(__VA_ARGS__ __VA_OPT__(,) ENO => RungiecTmp); end_if; RungiecVal := RungiecTmp}
{#define FBT_ENO(inst, type, ...) RungiecTmp := false; if RungiecEn then inst(__VA_ARGS__ __VA_OPT__(,) ENO => RungiecTmp); end_if; RungiecVal := RungiecTmp}
{#define FUN_ENO(fn, ...) RungiecTmp := false; if RungiecEn then fn(__VA_ARGS__ __VA_OPT__(,) ENO => RungiecTmp); end_if; RungiecVal := RungiecTmp}
{#define FUN_ENO_RET(dst, fn, ...) RungiecTmp := false; if RungiecEn then dst := fn(__VA_ARGS__ __VA_OPT__(,) ENO => RungiecTmp); end_if; RungiecVal := RungiecTmp}

(* Inline ST. ST_EXEC(statements): the ST statements run only when powered (not in an OFF MC zone); the power after the element equals the power before it. To pass a result on, assign it to a variable and read it with a contact: ST_EXEC(Ok := Pos > Lim;), CONTACT(Ok). *)
(* The statements are joined with the comma-protecting built-in, so a bare comma (case labels 1, 2:) is part of the statements and does not split the arguments of RUNG, SERIES, PARALLEL, WIRE or BEGIN_MC (tested in t099). The ';' after the last statement may be written or left out (an empty statement is valid ST). *)
(* Do not write DSL macros, return, directives, comments or Rungiec names in the statements. *)
{#define ST_EXEC(...) __assert(__VA_ARGC__ >= 1, RUNGIEC ST_EXEC has no statements) RungiecTmp := RungiecEn; if RungiecTmp then __nosplit(__VA_ARGS__); end_if; RungiecVal := RungiecTmp}

(* RETURN(): returns from the POU when powered. Write it as the last child of a top-level RUNG or WIRE; a WIRE with RETURN() or JMP() is the last WIRE before END_NET() (checked by the next WIRE, see WIRE). *)
{#define RETURN() _RUNGIEC_RETURN_CHECKS() RungiecTmp := RungiecEn; if RungiecTmp then return; end_if; RungiecVal := RungiecTmp}

(* Jumps for the target, chosen by the target macros that jiecc predefines. _RUNGIEC_JUMP_KW is the jump keyword of the expanded ST: jmp when _CODESYS is TRUE (jiecc -t codesys), goto otherwise and when jiepp runs alone (the target macros are not defined). _RUNGIEC_JUMP_OK is 0 when _OMRON, _KEYENCE or _MITSUBISHI is TRUE (jiecc -t omron, -t keyence, -t mitsubishi): JMP and LABEL are then a preprocessing error, because the jumps of the expanded ST are not known to load into the ST of those tools. Add a target here to give it another keyword. *)
{#if defined(_CODESYS) && _CODESYS}
{#define _RUNGIEC_JUMP_KW jmp}
{#define _RUNGIEC_JUMP_OK 1}
{#elif (defined(_OMRON) && _OMRON) || (defined(_KEYENCE) && _KEYENCE) || (defined(_MITSUBISHI) && _MITSUBISHI)}
{#define _RUNGIEC_JUMP_KW goto}
{#define _RUNGIEC_JUMP_OK 0}
{#else}
{#define _RUNGIEC_JUMP_KW goto}
{#define _RUNGIEC_JUMP_OK 1}
{#endif}
(* JMP(label): jumps to LABEL(label) of the same POU when powered. Write it as the last child of a top-level RUNG or WIRE; a WIRE with JMP() or RETURN() is the last WIRE before END_NET() (checked by the next WIRE, see WIRE). Before the jump it restores the state between networks, so the statement macro after the label does not fault. *)
(* Checks: a JMP back to a LABEL needs the same MC segment (no BEGIN_MC or END_MC between them); all forward JMPs to one label are in one segment, and LABEL checks that it is the segment of the label. A label that is never defined is the jiecc error UNDEFINED_SYMBOL. *)
(* The counter names are pasted from the label, so they are case-sensitive while ST labels are not: JMP(Skip) with LABEL(SKIP) passes these checks (lint LN22 reports it). *)
{#define JMP(label) _RUNGIEC_JMP_I(label, _RUNGIEC_CAT_X(rungiec_label_, label), _RUNGIEC_CAT_X(rungiec_jump_, label))}
{#define _RUNGIEC_JMP_I(label, lc, jc) _RUNGIEC_JMP_CHECKS(label, lc, jc) RungiecTmp := RungiecEn; if RungiecTmp then RungiecSp := 0; RungiecAcc := true; RungiecEn := RungiecRail; RungiecIn := RungiecRail; _RUNGIEC_JUMP_KW label; end_if; RungiecVal := RungiecTmp}

(* Statement macros: RUNG, BEGIN_MC, END_MC, LABEL, BEGIN_NET, WIRE and END_NET end their own statement with ';' (do not write one). *)
(* RUNG, WIRE, BEGIN_MC, END_MC, LABEL and END_NET have RungiecStIn[1 - RungiecSp] := RungiecIn (LABEL right after the label): index 1 at the top level, 0 or below when the macro was nested inside an element, so a nested one faults at run time. A BEGIN_NET written as a child of RUNG, WIRE or BEGIN_MC is a preprocessing error (the network check of the outer macro or of BEGIN_NET itself). *)
(* Between networks (after RUNG, END_NET, BEGIN_MC, END_MC and LABEL, and after a JMP that jumped): RungiecSp = 0, RungiecAcc = TRUE, RungiecEn = RungiecIn = RungiecRail. *)
{#define RUNG(...) __assert(__counter_peek(rungiec_net) = 0, RUNGIEC RUNG inside BEGIN_NET and END_NET) _RUNGIEC_ARITY_CHECK(RUNG, __VA_ARGC__) RungiecStIn[1 - RungiecSp] := RungiecIn; RungiecEn := RungiecRail; RungiecIn := RungiecRail; _RUNGIEC_SERIES_ANY(__VA_ARGS__);}

(* BEGIN_MC(conditions...): from here to the matching END_MC() the left rail is the series of the conditions under the current rail. Zones nest up to RUNGIEC_MC_MAX; END_MC() closes the innermost one. *)
{#define BEGIN_MC(...) _RUNGIEC_BEGIN_MC_CHECKS(__VA_ARGC__) RungiecStIn[1 - RungiecSp] := RungiecIn; RungiecEn := RungiecRail; RungiecIn := RungiecRail; _RUNGIEC_SERIES_ANY(__VA_ARGS__); RungiecMcSt[__counter_peek(rungiec_mc)] := RungiecRail; RungiecRail := RungiecVal; RungiecEn := RungiecRail; RungiecIn := RungiecRail;}
{#define END_MC() _RUNGIEC_END_MC_CHECKS() RungiecStIn[1 - RungiecSp] := RungiecIn; RungiecRail := RungiecMcSt[__counter_peek(rungiec_mc)]; RungiecEn := RungiecRail; RungiecIn := RungiecRail; _RUNGIEC_END_MC_DONE()}

(* LABEL(label): the target of JMP(label), written on its own between networks (or last before END_RUNGIEC()). The statement after the label lets it end a POU. Checks: the target allows jumps (_RUNGIEC_JUMP_OK), not inside BEGIN_NET and END_NET, defined once in the POU, and every earlier JMP(label) of the POU is in the same MC segment. *)
{#define LABEL(label) _RUNGIEC_LABEL_I(label, _RUNGIEC_CAT_X(rungiec_label_, label), _RUNGIEC_CAT_X(rungiec_jump_, label))}
{#define _RUNGIEC_LABEL_I(label, lc, jc) _RUNGIEC_LABEL_CHECKS(label, lc, jc) label: RungiecStIn[1 - RungiecSp] := RungiecIn;}

(* General networks. Node 0 is the left rail. WIRE(from, to, elements...) evaluates the elements in series from node from and ORs the result into node to. Node numbers are integer literals from 0 to 64 and not above RUNGIEC_NODE_MAX. *)
(* Rules: from < to; to is not less than the to node of the previous WIRE; numbers may be skipped; a node that no WIRE writes reads FALSE. That each number is an integer literal (node table), the range and the first two rules are checked at preprocessing time. *)
(* So every WIRE that writes a node comes before every WIRE that reads it. BEGIN_NET() sets node 0 to the rail and nodes 1 and up to FALSE on every scan, so no value leaks from an earlier network or scan. *)
(* A WIRE with JMP() or RETURN() is the last WIRE before END_NET(): a jump or return leaves at once, so a later WIRE of the network would not run on that scan. Each JMP() and RETURN() inside a network adds 2 to rungiec_exit while the arguments of its WIRE are expanded (before the checks of that WIRE); every WIRE checks that rungiec_exit is even (no earlier WIRE of the network has one) and then sets it to 1 if it is above 0. *)
{#define BEGIN_NET() _RUNGIEC_BEGIN_NET_CHECKS() for RungiecI := 1 to RUNGIEC_NODE_MAX do RungiecNode[RungiecI] := false; end_for; RungiecNode[0] := RungiecRail;}
{#define WIRE(from_node, to_node, ...) _RUNGIEC_WIRE_CHECKS(from_node, to_node, _RUNGIEC_COUNT(__VA_ARGS__)) RungiecStIn[1 - RungiecSp] := RungiecIn; RungiecEn := RungiecNode[from_node]; _RUNGIEC_SERIES_ANY(__VA_ARGS__); RungiecNode[to_node] := RungiecNode[to_node] or RungiecVal; _RUNGIEC_WIRE_DONE(to_node)}
{#define END_NET() _RUNGIEC_END_NET_CHECKS() RungiecStIn[1 - RungiecSp] := RungiecIn; RungiecEn := RungiecRail; RungiecIn := RungiecRail;}
{#endif}
