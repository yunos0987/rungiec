{#define _RUNGIEC_PARALLEL_5(c1, c2, c3, c4, c5) _RUNGIEC_PUSH() RungiecAcc := false; _RUNGIEC_P(c1) _RUNGIEC_P(c2) _RUNGIEC_P(c3) _RUNGIEC_P(c4) _RUNGIEC_P(c5) _RUNGIEC_POP()}
