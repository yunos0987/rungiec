(* rungiec_st.iec - the ST mode of RUNGIEC: the public macros expand to IEC 61131-3 ST. *)
(* rungiec.iec includes this file at its end in the ST mode (RUNGIEC_LD not defined or zero); include rungiec.iec, not this file. The checks and counter updates that both modes share, the settings and the node table are in rungiec.iec. *)
{#pragma once}
{#if !(defined(_RUNGIEC_LD) && _RUNGIEC_LD = 0)}
{#error RUNGIEC rungiec_st.iec is the ST mode part of rungiec.iec; include rungiec.iec instead}
{#else}
(* Working variable declarations. RungiecPrev is always static (var), never var_temp. *)
(* RungiecSp starts at -1 so that a POU whose BEGIN_RUNGIEC() init statements did not run faults on the first push (RungiecStIn[0] is out of bounds); the init statements set it to 0. *)
(* RungiecRail is the left power rail: TRUE, or the condition of the innermost open MC zone. RungiecNode holds the node values of a BEGIN_NET network (node 0 = rail); BEGIN_NET() clears nodes 1 and up with the loop index RungiecI. RungiecMcSt[d] keeps the rail outside the MC zone of depth d. *)
{#define _RUNGIEC_WORK_VARS() RungiecEn: bool := true; RungiecIn: bool := true; RungiecAcc: bool := true; RungiecVal: bool := true; RungiecTmp: bool; RungiecRail: bool := true; RungiecSp: dint := -1; RungiecStIn: array[1..RUNGIEC_NEST_MAX] of bool; RungiecStAcc: array[1..RUNGIEC_NEST_MAX] of bool; RungiecNode: array[0..RUNGIEC_NODE_MAX] of bool; RungiecI: dint; RungiecMcSt: array[1..RUNGIEC_MC_MAX] of bool;}
{#define _RUNGIEC_EDGE_VARS() RungiecPrev: array[1..RUNGIEC_EDGE_MAX] of bool;}
{#define _RUNGIEC_INIT() RungiecEn := true; RungiecIn := true; RungiecAcc := true; RungiecVal := true; RungiecTmp := false; RungiecRail := true; RungiecSp := 0;}

(* POU layout. After the user's own var blocks, write RUNGIEC_VAR() (or RUNGIEC_VAR_TEMP() / RUNGIEC_VAR_NOEDGE()), BEGIN_RUNGIEC(), the networks and END_RUNGIEC(). The statements go directly in the POU body (Jiecc 9.4.0 reads them as ST); neither the user nor these macros write a directive around them. *)
(* RUNGIEC_VAR(): the work variables and RungiecPrev, all in a var block. RUNGIEC_VAR_TEMP(): the work variables are var_temp (RungiecPrev stays static var). RUNGIEC_VAR_NOEDGE(): for a FUNCTION or METHOD; no RungiecPrev, so no edge contacts or transition coils. *)
(* BEGIN_RUNGIEC() and END_RUNGIEC() are common to the three. BEGIN_RUNGIEC() checks that the previous POU closed its networks, its MC zones and its BEGIN_RUNGIEC(), resets the counters (_RUNGIEC_START), then writes the init statements. END_RUNGIEC() checks that BEGIN_RUNGIEC() came before it and that every BEGIN_NET and BEGIN_MC of the POU is closed (_RUNGIEC_END); it expands to no ST. *)
{#define RUNGIEC_VAR() var _RUNGIEC_WORK_VARS() _RUNGIEC_EDGE_VARS() end_var}
{#define RUNGIEC_VAR_TEMP() var_temp _RUNGIEC_WORK_VARS() end_var var _RUNGIEC_EDGE_VARS() end_var}
{#define RUNGIEC_VAR_NOEDGE() var _RUNGIEC_WORK_VARS() end_var}
{#define BEGIN_RUNGIEC() _RUNGIEC_START() _RUNGIEC_INIT()}
{#define END_RUNGIEC() _RUNGIEC_END()}

{#define _RUNGIEC_CHILD(...) __assert(__VA_ARGC__ = 1, RUNGIEC empty element, look for a doubled or trailing comma) __VA_ARGS__}

(* Combinator stack handling. Elements and combinators end without ';' and their last statement is an assignment, *)
(* so two children written without a comma between them are a jiecc syntax error. The parent adds the ';'. *)
{#define _RUNGIEC_PUSH() RungiecSp := RungiecSp + 1; RungiecStIn[RungiecSp] := RungiecIn; RungiecStAcc[RungiecSp] := RungiecAcc; RungiecIn := RungiecEn;}
{#define _RUNGIEC_POP() RungiecVal := RungiecAcc; RungiecEn := RungiecIn; RungiecIn := RungiecStIn[RungiecSp]; RungiecAcc := RungiecStAcc[RungiecSp]; RungiecSp := RungiecSp - 1}
{#define _RUNGIEC_S(a) RungiecEn := RungiecAcc; _RUNGIEC_CHILD(a); RungiecAcc := RungiecVal;}
{#define _RUNGIEC_P(a) RungiecEn := RungiecIn; _RUNGIEC_CHILD(a); RungiecAcc := RungiecAcc or RungiecVal;}

(* Arity table: N = 1..32, generated by tools/gen_arity_table.py. Do not edit by hand. The arity limit is checked by _RUNGIEC_ARITY_CHECK. *)
{#define _RUNGIEC_SERIES_1(c1) _RUNGIEC_PUSH() RungiecAcc := RungiecIn; _RUNGIEC_S(c1) _RUNGIEC_POP()}
{#define _RUNGIEC_PARALLEL_1(c1) _RUNGIEC_PUSH() RungiecAcc := false; _RUNGIEC_P(c1) _RUNGIEC_POP()}
{#define _RUNGIEC_SERIES_2(c1, c2) _RUNGIEC_PUSH() RungiecAcc := RungiecIn; _RUNGIEC_S(c1) _RUNGIEC_S(c2) _RUNGIEC_POP()}
{#define _RUNGIEC_PARALLEL_2(c1, c2) _RUNGIEC_PUSH() RungiecAcc := false; _RUNGIEC_P(c1) _RUNGIEC_P(c2) _RUNGIEC_POP()}
{#define _RUNGIEC_SERIES_3(c1, c2, c3) _RUNGIEC_PUSH() RungiecAcc := RungiecIn; _RUNGIEC_S(c1) _RUNGIEC_S(c2) _RUNGIEC_S(c3) _RUNGIEC_POP()}
{#define _RUNGIEC_PARALLEL_3(c1, c2, c3) _RUNGIEC_PUSH() RungiecAcc := false; _RUNGIEC_P(c1) _RUNGIEC_P(c2) _RUNGIEC_P(c3) _RUNGIEC_POP()}
{#define _RUNGIEC_SERIES_4(c1, c2, c3, c4) _RUNGIEC_PUSH() RungiecAcc := RungiecIn; _RUNGIEC_S(c1) _RUNGIEC_S(c2) _RUNGIEC_S(c3) _RUNGIEC_S(c4) _RUNGIEC_POP()}
{#define _RUNGIEC_PARALLEL_4(c1, c2, c3, c4) _RUNGIEC_PUSH() RungiecAcc := false; _RUNGIEC_P(c1) _RUNGIEC_P(c2) _RUNGIEC_P(c3) _RUNGIEC_P(c4) _RUNGIEC_POP()}
