# Python bytecode cache
__pycache__/
*.pyc
# Tool binaries (jiepp, jiecc) placed in tools/ by each user; not tracked
tools/*.exe
tools/jiepp
tools/jiecc
# Downloads and expanded ST of the README quick start
/out/
# Expanded ST and run logs of the jiecunit tests (tNNN_*, x_*): large and regenerated by tools/run_tests.py.
# The e/f/r outputs and the expected LD XML of the examples (<example>.ld.xml) stay tracked.
tests/expanded/t[0-9]*
tests/expanded/x_*
# The LD XML that tools/run_tests.py writes when it differs from the expected file (reviewed, then renamed).
tests/expanded/*.ld.xml.new
